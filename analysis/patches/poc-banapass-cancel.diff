+// exvs2-lobbies proposal: one generation number per BngRwReqWaitTouch instead of a shared bool + 250 ms sleep.
+// A reader thread only fires while its generation is current, fires at most once, and exits after that.
+static std::atomic<unsigned> touchGeneration{0};
+static std::mutex touchMutex;
+static void (*pendingTouchCallback)(int, int, void*, void*) = nullptr;
+static void* pendingTouchContext = nullptr;
+
+// Claim the pending touch request of generation `gen` (false if it was cancelled or replaced meanwhile).
+static bool ClaimTouch(unsigned gen)
+{
+    std::lock_guard<std::mutex> lock(touchMutex);
+    if (touchGeneration.load() != gen || pendingTouchCallback == nullptr) return false;
+    pendingTouchCallback = nullptr;
+    pendingTouchContext = nullptr;
+    touchGeneration.fetch_add(1);
+    return true;
+}
 
