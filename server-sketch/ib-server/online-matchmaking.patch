diff --git a/Tests/Matchmaking.Tests/MatchmakerTests.cs b/Tests/Matchmaking.Tests/MatchmakerTests.cs
new file mode 100644
index 0000000..0259904
--- /dev/null
+++ b/Tests/Matchmaking.Tests/MatchmakerTests.cs
@@ -0,0 +1,528 @@
+using nue.protocol.mms;
+using ServerInfinite.Matchmaking;
+using Xunit;
+
+namespace Matchmaking.Tests;
+
+// EXPERIMENTAL: message shapes follow static analysis of vsac29, not a live capture.
+public class MatchmakerTests
+{
+    private uint _node = 100;
+
+    private static Client Cl(uint node, bool human = true, string loc = "LOC1")
+    {
+        var c = new Client
+        {
+            NodeId = node, PcbSerial = human ? $"P{node}" : Matchmaker.NpcSerial, LocId = loc, PrefCode = 13,
+            NatMappingType = NatMappingType.NmEndpointIndependent, NatFilteringType = NatFilteringType.NfEndpointIndependent
+        };
+        c.Properties.Add(new Client.Property { PropertyId = 0, PropertyValue = human ? "Y" : "N" });
+        return c;
+    }
+
+    private Request.EntryMatching Entry(uint world, string sortie = "S", long attr2 = 0, long level = 0, uint timeout = 150)
+    {
+        var me = ++_node;
+        var loc = $"L{me}";
+        var e = new Request.EntryMatching
+        {
+            ApplyId = 1, Myclient = Cl(me, true, loc), MatchingTimeout = timeout,
+            Myplayer = new Player { BanapassportAmId = me },
+            World = new World { MuchaGameId = "GIB1", Version = 1, WorldId = world }
+        };
+        e.Myplayer.Parameters.Add(new Player.Parameter { AttributeId = 1, parameter = 0 });
+        e.Myplayer.Parameters.Add(new Player.Parameter { AttributeId = 2, parameter = attr2 });
+        e.Myplayer.Parameters.Add(new Player.Parameter { AttributeId = 4, parameter = level });
+        if (sortie == "T")
+            e.Groups.Add(new Request.EntryMatching.Group { Client = Cl(++_node, true, loc), Player = new Player { BanapassportAmId = 9000 + me } });
+        if (sortie == "TN")
+            e.Groups.Add(new Request.EntryMatching.Group { Client = Cl(++_node, false, loc), Player = new Player() });
+        return e;
+    }
+
+    // StaleAfter is raised because these tests jump the clock without the other cabinets polling.
+    private static Matchmaker New() => new(fillAfter: 30, allowPartial: true, softWait: 15, seed: 1) { StaleAfter = 1e6 };
+
+    [Fact]
+    public void FourSolosAreShuffledIntoTwoPairs()
+    {
+        var mm = New();
+        var es = Enumerable.Range(0, 4).Select(_ => Entry(23)).ToList();
+        es.ForEach(e => Assert.Equal(ErrorCode.Success, mm.Entry(e, 0)));
+        var (code, room, _) = mm.Check(es[0].Myclient.NodeId, 1);
+        Assert.Equal(ErrorCode.Success, code);
+        Assert.NotNull(room);
+        Assert.Equal(4, room!.Clients.Count);
+        Assert.Equal(2, room.Clients.Count(c => c.GroupId == 0));
+        foreach (var e in es) Assert.Same(room, mm.Check(e.Myclient.NodeId, 1).Room);
+    }
+
+    [Fact]
+    public void FixedPairIsNeverSplit()
+    {
+        var mm = New();
+        var team = Entry(18, "T");
+        mm.Entry(team, 0);
+        mm.Entry(Entry(18), 0);
+        mm.Entry(Entry(18), 0);
+        var room = mm.Check(team.Myclient.NodeId, 1).Room!;
+        var g = room.Clients.First(c => c.Client.NodeId == team.Myclient.NodeId).GroupId;
+        Assert.Equal(g, room.Clients.First(c => c.Client.NodeId == team.Groups[0].Client.NodeId).GroupId);
+        // the partner cabinet polls with its own node id and sees the same room
+        Assert.Same(room, mm.Check(team.Groups[0].Client.NodeId, 1).Room);
+    }
+
+    [Fact]
+    public void TwoTeamsWithCpuPartnersMatch()
+    {
+        var mm = New();
+        var a = Entry(5, "TN");
+        var b = Entry(5, "TN");
+        mm.Entry(a, 0);
+        mm.Entry(b, 0);
+        var room = mm.Check(a.Myclient.NodeId, 1).Room!;
+        Assert.Equal(4, room.Clients.Count);
+        Assert.Equal(2, room.Humans);
+    }
+
+    [Fact]
+    public void DifferentModesNeverMix()
+    {
+        var mm = New();
+        mm.Entry(Entry(18), 0); mm.Entry(Entry(18), 0);
+        var x = Entry(23); mm.Entry(x, 0); mm.Entry(Entry(23), 0);
+        Assert.Null(mm.Check(x.Myclient.NodeId, 1).Room);
+        Assert.Equal(4, mm.QueueLength);
+    }
+
+    [Fact]
+    public void RankedKeepsClassesApart()
+    {
+        var mm = New();
+        var c2 = Enumerable.Range(0, 2).Select(_ => Entry(13, "S", attr2: 2, level: 3)).ToList();
+        var c3 = Enumerable.Range(0, 2).Select(_ => Entry(13, "S", attr2: 3, level: 3)).ToList();
+        foreach (var e in c2.Concat(c3)) mm.Entry(e, 0);
+        Assert.Null(mm.Check(c2[0].Myclient.NodeId, 1).Room);
+        mm.Entry(Entry(13, "S", attr2: 2, level: 3), 1);
+        mm.Entry(Entry(13, "S", attr2: 2, level: 3), 1);
+        var room = mm.Check(c2[0].Myclient.NodeId, 2).Room!;
+        Assert.Equal(4, room.Clients.Count);
+        Assert.DoesNotContain(room.Clients, c => c3.Any(e => e.Myclient.NodeId == c.Client.NodeId));
+    }
+
+    [Fact]
+    public void RankedLevelBandWidensWithTime()
+    {
+        var mm = new Matchmaker(fillAfter: 1000, allowPartial: false, seed: 1) { StaleAfter = 1e6 };
+        var es = new[] { Entry(13, "S", 2, 1), Entry(13, "S", 2, 1), Entry(13, "S", 2, 3), Entry(13, "S", 2, 3) };
+        foreach (var e in es) mm.Entry(e, 0);
+        Assert.Null(mm.Check(es[0].Myclient.NodeId, 10).Room);   // |1-3| = 2 > band 0/1
+        Assert.NotNull(mm.Check(es[0].Myclient.NodeId, 36).Room); // after 35 s the band is 2
+    }
+
+    [Fact]
+    public void ShortHandedRoomOnlyAfterFillTimer()
+    {
+        var mm = New();
+        var a = Entry(23); var b = Entry(23);
+        mm.Entry(a, 0); mm.Entry(b, 0);
+        Assert.Null(mm.Check(a.Myclient.NodeId, 10).Room);
+        var room = mm.Check(a.Myclient.NodeId, 31).Room!;
+        Assert.Equal(2, room.Clients.Count);
+        Assert.NotEqual(room.Clients[0].GroupId, room.Clients[1].GroupId);  // 1v1
+    }
+
+    [Fact]
+    public void CancelAndTimeout()
+    {
+        var mm = New();
+        var a = Entry(23, timeout: 90);
+        mm.Entry(a, 0);
+        mm.Cancel(a.Myclient.NodeId);
+        Assert.Equal(ErrorCode.ErrMatchNoentry, mm.Check(a.Myclient.NodeId, 1).Code);
+        var b = Entry(23, timeout: 90);
+        mm.Entry(b, 0);
+        Assert.Equal(ErrorCode.MatchCanceled, mm.Check(b.Myclient.NodeId, 91).Code);
+    }
+
+    [Fact]
+    public void BlacklistedCardIsNotMatched()
+    {
+        var mm = new Matchmaker(fillAfter: 0, allowPartial: true, seed: 1) { StaleAfter = 1e6 };
+        var a = Entry(23); var b = Entry(23);
+        a.BlBanapassportAmIds = new[] { b.Myplayer.BanapassportAmId };
+        mm.Entry(a, 0); mm.Entry(b, 0);
+        Assert.Null(mm.Check(a.Myclient.NodeId, 100).Room);
+    }
+
+    // ---- regressions found by server-sketch/loadtest (2026-11-13) ----
+
+    [Fact]
+    public void PartnerOfTimedOutPairGetsMatchCanceledNotNoEntry()
+    {
+        var mm = New();
+        var pair = Entry(14, "T", attr2: 3, timeout: 60);
+        var partner = pair.Groups[0].Client.NodeId;
+        mm.Entry(pair, 0);
+        Assert.Equal(ErrorCode.MatchCanceled, mm.Check(partner, 61).Code);              // partner polls first
+        Assert.Equal(ErrorCode.MatchCanceled, mm.Check(pair.Myclient.NodeId, 62).Code);  // was ERR_MATCH_NOENTRY
+        Assert.Equal(ErrorCode.ErrMatchNoentry, mm.Check(pair.Myclient.NodeId, 63).Code);
+    }
+
+    [Fact]
+    public void PartnerOfCancelledPairGetsMatchCanceled()
+    {
+        var mm = New();
+        var pair = Entry(23, "T");
+        mm.Entry(pair, 0);
+        mm.Cancel(pair.Myclient.NodeId, 5);
+        Assert.Equal(ErrorCode.MatchCanceled, mm.Check(pair.Groups[0].Client.NodeId, 6).Code);
+        Assert.Equal(ErrorCode.ErrMatchNoentry, mm.Check(pair.Myclient.NodeId, 6).Code);
+    }
+
+    [Fact]
+    public void CabinetThatStoppedPollingIsNotMatched()
+    {
+        var mm = new Matchmaker(fillAfter: 30, allowPartial: true, softWait: 15, seed: 1);   // default StaleAfter 20 s
+        var gone = Entry(23);
+        mm.Entry(gone, 0);                                     // never polls again
+        var es = Enumerable.Range(0, 3).Select(_ => Entry(23)).ToList();
+        foreach (var e in es) mm.Entry(e, 25);
+        foreach (var e in es) Assert.Null(mm.Check(e.Myclient.NodeId, 26).Room);   // no room with the ghost
+        Assert.Equal(ErrorCode.MatchCanceled, mm.Check(gone.Myclient.NodeId, 27).Code);
+        var fourth = Entry(23);
+        mm.Entry(fourth, 27);
+        var room = mm.Check(es[0].Myclient.NodeId, 28).Room;
+        Assert.NotNull(room);
+        Assert.DoesNotContain(room!.Clients, c => c.Client.NodeId == gone.Myclient.NodeId);
+    }
+
+    [Fact]
+    public void ForeignCabinetCannotTakeOverANodeId()
+    {
+        var mm = New();
+        var victim = Entry(23, "T");
+        mm.Entry(victim, 0);
+        var evil = Entry(23);
+        evil.Myclient.NodeId = victim.Myclient.NodeId;        // guessed node id, different pcb_serial
+        evil.Myclient.PcbSerial = "EVIL";
+        Assert.Equal(ErrorCode.ErrDuplicateEntry, mm.Entry(evil, 1));
+        Assert.Equal(1, mm.QueueLength);
+        var es = Enumerable.Range(0, 2).Select(_ => Entry(23)).ToList();
+        foreach (var e in es) mm.Entry(e, 2);
+        var room = mm.Check(victim.Myclient.NodeId, 3).Room;
+        Assert.NotNull(room);                                  // victim's pair still matched normally
+        Assert.Contains(room!.Clients, c => c.Client.NodeId == victim.Groups[0].Client.NodeId);
+        Assert.DoesNotContain(room.Clients, c => c.Client.PcbSerial == "EVIL");
+    }
+
+    [Fact]
+    public void SameCabinetReEntryAndPartnerEntryStillWork()
+    {
+        var mm = New();
+        var pair = Entry(23, "T");
+        mm.Entry(pair, 0);
+        var own = new Request.EntryMatching
+        {
+            ApplyId = 2, Myclient = pair.Groups[0].Client, Myplayer = pair.Groups[0].Player,
+            World = pair.World, MatchingTimeout = 150
+        };
+        own.Groups.Add(new Request.EntryMatching.Group { Client = pair.Myclient, Player = pair.Myplayer });
+        Assert.Equal(ErrorCode.Success, mm.Entry(own, 1));     // partner's own entry merges
+        Assert.Equal(ErrorCode.Success, mm.Entry(pair, 2));    // duplicate entry from the same cabinet
+        Assert.Equal(1, mm.QueueLength);
+    }
+
+    [Fact]
+    public void DuplicateEntryAfterMatchDoesNotCreateASecondRoom()
+    {
+        var mm = New();
+        var es = Enumerable.Range(0, 4).Select(_ => Entry(23)).ToList();
+        foreach (var e in es) mm.Entry(e, 0);
+        var room = mm.Check(es[0].Myclient.NodeId, 1).Room;
+        Assert.NotNull(room);
+        Assert.Equal(ErrorCode.Success, mm.Entry(es[0], 2));   // retried / duplicated entry
+        Assert.Equal(0, mm.QueueLength);
+        var more = Enumerable.Range(0, 3).Select(_ => Entry(23)).ToList();
+        foreach (var e in more) mm.Entry(e, 3);
+        Assert.Same(room, mm.Check(es[0].Myclient.NodeId, 4).Room);
+        Assert.Null(mm.Check(more[0].Myclient.NodeId, 4).Room);
+    }
+
+    [Fact]
+    public void NewEntryFromSameCabinetReplacesItsOldWait()
+    {
+        var mm = New();
+        var old = Entry(15, attr2: 7);
+        mm.Entry(old, 0);                                       // left the in-store queue without cancelling
+        var again = Entry(23);
+        again.Myclient.PcbSerial = old.Myclient.PcbSerial;      // same cabinet, new node ids, other mode
+        mm.Entry(again, 5);
+        Assert.Equal(1, mm.QueueLength);
+        Assert.Equal(ErrorCode.MatchCanceled, mm.Check(old.Myclient.NodeId, 6).Code);
+        var mate = Entry(15, attr2: 7);
+        mm.Entry(mate, 7);
+        Assert.Null(mm.Check(mate.Myclient.NodeId, 100).Room);  // the old wait can no longer be matched
+    }
+
+    [Fact]
+    public void EntryWithNodeIdZeroIsRejected()
+    {
+        var mm = New();
+        var e = Entry(23);
+        e.Myclient.NodeId = 0;
+        Assert.Equal(ErrorCode.ErrNodeid, mm.Entry(e, 0));
+        Assert.Equal(0, mm.QueueLength);
+    }
+
+    [Fact]
+    public void NodeIdsAreUniqueAndPersisted()
+    {
+        var path = Path.Combine(Path.GetTempPath(), $"nodeids-{Guid.NewGuid():n}.json");
+        try
+        {
+            var first = new FileNodeIdAllocator(path, 1000).Take(2);
+            var second = new FileNodeIdAllocator(path, 1000).Take(2);
+            Assert.Equal(new uint[] { 1000, 1001 }, first);
+            Assert.Equal(new uint[] { 1002, 1003 }, second);
+        }
+        finally { File.Delete(path); }
+    }
+
+    // ---- disconnect test 2026-11-13 ----
+
+    [Fact]
+    public void SameNodeReEntryWithNewApplyIdReplacesTheOldEntry()
+    {
+        var mm = New();
+        var a = Entry(23);
+        mm.Entry(a, 0);                                         // dropped, came back, picked another mode
+        var again = Entry(18);
+        again.Myclient = a.Myclient; again.Myplayer = a.Myplayer; again.ApplyId = 2;
+        mm.Entry(again, 5);
+        Assert.Equal(1, mm.QueueLength);
+        foreach (var e in Enumerable.Range(0, 3).Select(_ => Entry(23)).ToList()) mm.Entry(e, 6);
+        Assert.Null(mm.Check(a.Myclient.NodeId, 7).Room);       // not in the old mode any more
+        foreach (var e in Enumerable.Range(0, 3).Select(_ => Entry(18)).ToList()) mm.Entry(e, 8);
+        var room = mm.Check(a.Myclient.NodeId, 9).Room;
+        Assert.NotNull(room);
+        Assert.Equal(18u, room!.World);
+    }
+
+    [Theory]
+    [InlineData(true)]
+    [InlineData(false)]
+    public void PairIsDroppedWhenOneCabinetStopsPolling(bool leaderVanishes)
+    {
+        var mm = new Matchmaker(fillAfter: 1000, allowPartial: true, softWait: 15, seed: 1);   // StaleAfter 20 s
+        var pair = Entry(23, "T");
+        mm.Entry(pair, 0);
+        uint lead = pair.Myclient.NodeId, mate = pair.Groups[0].Client.NodeId;
+        var (alive, gone) = leaderVanishes ? (mate, lead) : (lead, mate);
+        mm.Check(lead, 1); mm.Check(mate, 1);
+        for (var t = 4; t <= 19; t += 3) Assert.Equal(ErrorCode.Success, mm.Check(alive, t).Code);
+        Assert.Equal(ErrorCode.MatchCanceled, mm.Check(alive, 22).Code);   // gone > 20 s: told, not matched
+        foreach (var e in Enumerable.Range(0, 2).Select(_ => Entry(23)).ToList()) mm.Entry(e, 23);
+        Assert.Equal(2, mm.QueueLength);                          // the pair is no longer matchable
+        Assert.Equal(ErrorCode.MatchCanceled, mm.Check(gone, 30).Code);
+    }
