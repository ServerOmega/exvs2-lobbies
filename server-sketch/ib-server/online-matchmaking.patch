@@ -0,0 +1,54 @@
+namespace ServerInfinite.Models.Config;
+
+/// <summary>
+/// [exvs2-lobbies / EXPERIMENTAL, untested with the real game]
+/// Online (WAN) matchmaking settings. The cabinet only starts online matching (STUN + IssueNodeId)
+/// when RegisterPcb returns an SRV_STUN entry, and it uses the SRV_MATCH "uri" verbatim as the full
+/// MMS URL (the port field is ignored). The cabinet itself must use battleMode 0 in testmode_pcb.json.
+/// </summary>
+public class OnlineMatchingConfigurations
+{
+    /// <summary>When false, RegisterPcb behaves like upstream (SRV_MATCH only, no STUN).</summary>
+    public bool Enabled { get; set; } = false;
+
+    /// <summary>
+    /// Full MMS URL sent to the cabinet, e.g. "http://192.168.1.105:28080/match".
+    /// Empty = "http://{host the cabinet used to reach this server}/match" (the built-in MMS).
+    /// Point it at server-sketch/python/mms_server.py (e.g. "http://host:5000/mms") to use the external one.
+    /// </summary>
+    public string MatchUrl { get; set; } = "";
+
+    /// <summary>STUN host (an IP literal is safest). Empty = the host part of the request's Host header.</summary>
+    public string StunHost { get; set; } = "";
+    public uint StunPort { get; set; } = 3478;
+    /// <summary>Only used if the STUN server answers 401/438 (long-term credentials).</summary>
+    public string StunUser { get; set; } = "";
+    [System.Text.Json.Serialization.JsonIgnore] // keep it out of the startup config log
+    public string StunPass { get; set; } = "";
+
+    /// <summary>Seconds between CheckMatching polls (EntryMatching.poling_interval).</summary>
+    public uint PollingIntervalSeconds { get; set; } = 3;
+    /// <summary>Seconds the oldest waiter waits for a full 2v2 before a short-handed (1v1 / 2v1) room may form.</summary>
+    public double FillAfterSeconds { get; set; } = 30;
+    /// <summary>Allow short-handed rooms at all (false = only full 4-slot rooms).</summary>
+    public bool AllowPartialRooms { get; set; } = true;
+    /// <summary>Seconds during which a "soft" mode attribute (win-rate bucket, veteran flag) must match.</summary>
+    public double SoftAttributeWaitSeconds { get; set; } = 15;
+    /// <summary>File that persists the next node id so ids never repeat across restarts.</summary>
+    public string NodeIdStateFile { get; set; } = "mms_nodeids.json";
+    /// <summary>First node id handed out on a fresh install.</summary>
+    public uint FirstNodeId { get; set; } = 1000;
+    /// <summary>Random seed for shuffles (0 = random). Only useful for tests.</summary>
+    public int ShuffleSeed { get; set; } = 0;
+
+    /// <summary>
+    /// LoadClassMatch schedule rows. IB appears to compare schedule start/end against the local HOUR
+    /// (static analysis, ranked-matching.md 2.3) while upstream sends unix times. "Both" sends an hour row
+    /// (0..27) and a unix row, both pointing at the same pattern, so either interpretation finds a pattern.
+    /// Values: "Both" (default), "Hours", "UnixTime" (upstream behaviour).
+    /// </summary>
+    public string ClassMatchScheduleMode { get; set; } = "Both";
+
+    /// <summary>Store rate / class / grade reported in SaveVsmOnResult.class_match_result (ranked).</summary>
+    public bool PersistClassMatchResult { get; set; } = true;
+}
