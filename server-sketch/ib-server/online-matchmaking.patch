+            stun.AccountPass = mm.StunPass;
+        }
+        registerPcb.ServerInfoes.Add(stun);
+
+        // exvs2-lobbies: one line per RegisterPcb with what this cabinet was told (addresses only, no serial)
+        var src = _http?.HttpContext?.Connection.RemoteIpAddress;
+        if (src is { IsIPv4MappedToIPv6: true }) src = src.MapToIPv4();
+        var srcText = src?.ToString() ?? "-";
+        _logger?.LogInformation("NET register-pcb src={Source} -> match={Match} stun={Stun}:{Port}",
+            srcText, matchUrl, stunHost, mm.StunPort);
+        if (src != null && !System.Net.IPAddress.IsLoopback(src) &&
+            (IsLoopbackHost(stunHost) || IsLoopbackHost(HostOfUrl(matchUrl))))
+            _logger?.LogWarning("NET-WARN register-pcb src={Source}: a remote cabinet was given a loopback " +
+                                "match/STUN address ({Match}, {Stun}) - set MatchUrl/StunHost to an address it can reach",
+                srcText, matchUrl, stunHost);
+    }
+
+    private static bool IsLoopbackHost(string host) =>
+        host is "localhost" or "::1" || host.StartsWith("127.");
+
+    private static string HostOfUrl(string url) =>
+        Uri.TryCreate(url, UriKind.Absolute, out var u) ? u.Host.Trim('[', ']') : "";
+
+    private static string HostOnly(string baseAddress)
+    {
+        // "1.2.3.4:28080" -> "1.2.3.4", "[::1]:28080" -> "::1"
+        if (baseAddress.StartsWith('['))
+        {
+            var end = baseAddress.IndexOf(']');
+            return end > 0 ? baseAddress[1..end] : baseAddress;
+        }
+        var colon = baseAddress.LastIndexOf(':');
+        return colon > 0 ? baseAddress[..colon] : baseAddress;
+    }
