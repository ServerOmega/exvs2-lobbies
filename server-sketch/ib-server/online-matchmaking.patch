+    /// <summary>
+    /// exvs2-lobbies / EXPERIMENTAL. The cabinet picks a schedule row covering "now", takes its pattern and looks up
+    /// (class, grade) -> level_id; level is sent to the MMS as attr4 (default 3 if nothing matches). IB seems to
+    /// compare against the local hour (0..27, arcade day) rather than unix time [static analysis], so by default
+    /// both an hour row and a unix row are sent, pointing at the same pattern.
+    /// Grade buckets: grades 10-8 -> level 1, 7-5 -> 2, 4-3 -> 3, 2-1 -> 4 (0 = unknown -> level 3).
+    /// </summary>
+    private void FillClassMatchingTables(Response.LoadClassMatch response)
+    {
+        const uint patternId = 1;
+        var mode = (_online.ClassMatchScheduleMode ?? "Both").Trim().ToLowerInvariant();
+        if (mode is "both" or "hours")
+        {
+            response.ClassMatchingTimeSchedules.Add(new Response.LoadClassMatch.ClassMatchingTimeSchedule
+            {
+                StartAt = 0, EndAt = 27, PatternId = patternId
+            });
+        }
+        if (mode is "both" or "unixtime" || response.ClassMatchingTimeSchedules.Count == 0)
+        {
+            response.ClassMatchingTimeSchedules.Add(new Response.LoadClassMatch.ClassMatchingTimeSchedule
+            {
+                StartAt = (ulong)(DateTimeOffset.Now - TimeSpan.FromDays(10)).ToUnixTimeSeconds(),
+                EndAt = (ulong)(DateTimeOffset.Now + TimeSpan.FromDays(365)).ToUnixTimeSeconds(),
+                PatternId = patternId
+            });
+        }
+
+        var gradeBuckets = new (uint Level, uint Start, uint End)[] { (1, 8, 10), (2, 5, 7), (3, 3, 4), (4, 1, 2), (3, 0, 0) };
+        var pattern = new Response.LoadClassMatch.ClassMatchingPatternTable { PatternId = patternId };
+        for (uint classId = 1; classId <= 4; classId++)
+        {
+            foreach (var (level, start, end) in gradeBuckets)
+            {
+                var row = new Response.LoadClassMatch.ClassMatchingPatternTable.ClassMatchingPattern
+                {
+                    ClassId = classId, LevelId = level, GradeIdStart = start, GradeIdEnd = end
+                };
+                pattern.ClassMatchingSoloes.Add(row);
+                if (classId >= 2) // Pilot (1) is solo-only per the official rules
+                {
+                    pattern.ClassMatchingTeams.Add(new Response.LoadClassMatch.ClassMatchingPatternTable.ClassMatchingPattern
+                    {
+                        ClassId = classId, LevelId = level, GradeIdStart = start, GradeIdEnd = end
+                    });
+                }
+            }
+        }
+        response.ClassMatchingPatternTables.Add(pattern);
+
+        // One room search id for everything: with a single central matcher "make room vs search" does not matter.
+        response.ClassMatchingRequestTables.Add(new Response.LoadClassMatch.ClassMatchingRequest
+        {
+            MakeRoomFlag = true,
+            MatchingTryNum = 3,
+            RoomSearchId = 1,
+            SeqNum = 1
+        });
+
+        response.search_ratios ??= new Response.LoadClassMatch.SearchRatioTable();
+        for (uint classId = 1; classId <= 4; classId++)
+        {
+            for (uint level = 1; level <= 4; level++)
+            {
+                response.search_ratios.search_ratio_solo.Add(new Response.LoadClassMatch.SearchRatioTable.SearchRatio
+                {
+                    ClassId = classId, LevelId = level, Num = 1, search_ratio = 1
+                });
+                if (classId >= 2)
+                {
+                    response.search_ratios.search_ratio_team.Add(new Response.LoadClassMatch.SearchRatioTable.SearchRatio
+                    {
+                        ClassId = classId, LevelId = level, Num = 1, search_ratio = 1
+                    });
+                }
+            }
+        }
+    }
