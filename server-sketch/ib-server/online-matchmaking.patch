index 0000000..fbbdb65
--- /dev/null
+++ b/Server-Infinite/Handlers/Match/MatchingQueueCommandHandlers.cs
@@ -0,0 +1,104 @@
+using MediatR;
+using Microsoft.Extensions.Options;
+using nue.protocol.mms;
+using ServerInfinite.Matchmaking;
+using ServerInfinite.Models.Config;
+
+namespace ServerInfinite.Handlers.Match;
+
+// exvs2-lobbies / EXPERIMENTAL: EntryMatching / CheckMatching / CancelMatching (upstream answered ERR_SERVER).
+// Shapes follow static analysis of vsac29 (analysis/matchmaking.md 2.2-2.4); never tested with the real game.
+
+public record EntryMatchingCommand(Request Request) : IRequest<Response>;
+public record CheckMatchingCommand(Request Request) : IRequest<Response>;
+public record CancelMatchingCommand(Request Request) : IRequest<Response>;
+
+internal static class MmsClock
+{
+    public static double Now => DateTimeOffset.UtcNow.ToUnixTimeMilliseconds() / 1000.0;
+}
+
+public class EntryMatchingCommandHandler : IRequestHandler<EntryMatchingCommand, Response>
+{
+    private readonly Matchmaker _mm;
+    private readonly OnlineMatchingConfigurations _cfg;
+
+    public EntryMatchingCommandHandler(Matchmaker mm, IOptions<CardServerConfig> options)
+    {
+        _mm = mm;
+        _cfg = options.Value.OnlineMatching;
+    }
+
+    public Task<Response> Handle(EntryMatchingCommand request, CancellationToken cancellationToken)
+    {
+        var req = request.Request;
+        var e = req.entry_matching;
+        var response = new Response { Type = req.Type, RequestId = req.RequestId ?? "" };
+        if (e?.Myclient == null)
+        {
+            response.Code = ErrorCode.ErrRequest;
+            return Task.FromResult(response);
+        }
+        response.Code = _mm.Entry(e, MmsClock.Now);
+        // The game only reads poling_interval (seconds); apply_id is proto2-required so echo it.
+        response.entry_matching = new Response.EntryMatching
+        {
+            PolingInterval = Math.Max(1u, _cfg.PollingIntervalSeconds),
+            ApplyId = e.ApplyId
+        };
+        return Task.FromResult(response);
+    }
+}
+
+public class CheckMatchingCommandHandler : IRequestHandler<CheckMatchingCommand, Response>
+{
+    private readonly Matchmaker _mm;
+
+    public CheckMatchingCommandHandler(Matchmaker mm) => _mm = mm;
+
+    public Task<Response> Handle(CheckMatchingCommand request, CancellationToken cancellationToken)
+    {
+        var req = request.Request;
+        var (code, room, applyId) = _mm.Check(req.check_matching?.NodeId ?? 0, MmsClock.Now);
+        var body = new Response.CheckMatching();
+        if (room != null)
+        {
+            // room_id + ALL clients incl. the requester and CPU stand-ins; group_id = team (0/1)
+            body.RoomId = room.RoomId;
+            body.ApplyId = applyId;
+            body.Clients.AddRange(room.Clients.Select(c => new Response.CheckMatching.MatchedClient
+            {
+                GroupId = c.GroupId,
+                Client = c.Client
+            }));
+        }
+        // code 0 + empty client list = "keep polling"
+        return Task.FromResult(new Response
+        {
+            Type = req.Type,
+            RequestId = req.RequestId ?? "",
+            Code = code,
+            check_matching = body
+        });
+    }
+}
+
+public class CancelMatchingCommandHandler : IRequestHandler<CancelMatchingCommand, Response>
+{
+    private readonly Matchmaker _mm;
+
+    public CancelMatchingCommandHandler(Matchmaker mm) => _mm = mm;
+
+    public Task<Response> Handle(CancelMatchingCommand request, CancellationToken cancellationToken)
+    {
+        var req = request.Request;
+        _mm.Cancel(req.cancel_matching?.NodeId ?? 0);   // the game ignores this reply
+        return Task.FromResult(new Response
+        {
+            Type = req.Type,
+            RequestId = req.RequestId ?? "",
+            Code = ErrorCode.Success,
+            cancel_matching = new Response.CancelMatching()
+        });
+    }
+}
