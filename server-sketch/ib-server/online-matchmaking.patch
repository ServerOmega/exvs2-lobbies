+    // ---- one universal server: LM-store players, standalone players, many LMs (analysis/lm-and-online.md) ----
+
+    private Request.EntryMatching At(string serial, string loc, string global, string local, string sortie = "S",
+        string? partnerSerial = null, string? partnerLocal = null)
+    {
+        var e = Entry(23, sortie);
+        e.Myclient.PcbSerial = serial; e.Myclient.LocId = loc; e.Myclient.GlobalIpaddress = global; e.Myclient.LocalIpaddress = local;
+        if (partnerSerial != null)
+        {
+            var p = e.Groups[0].Client;
+            p.PcbSerial = partnerSerial; p.LocId = loc; p.GlobalIpaddress = global; p.LocalIpaddress = partnerLocal ?? local;
+        }
+        return e;
+    }
