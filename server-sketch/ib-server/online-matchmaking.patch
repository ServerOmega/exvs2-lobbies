+    [Fact]
+    public void NodeFromBeforeARestartGetsMatchCanceled()
+    {
+        var path = Path.Combine(Path.GetTempPath(), $"nodeids-{Guid.NewGuid():n}.json");
+        try
+        {
+            var before = new FileNodeIdAllocator(path, 1000);
+            Assert.Equal(0u, before.FirstThisRun);                // fresh install: nothing issued earlier
+            var old = before.Take(2)[0];
+            var after = new FileNodeIdAllocator(path, 1000);     // server restarted, queue lost
+            var mm = new Matchmaker(seed: 1) { FirstNodeThisRun = after.FirstThisRun };
+            Assert.Equal(ErrorCode.MatchCanceled, mm.Check(old, 0).Code);
+            Assert.Equal(ErrorCode.ErrMatchNoentry, mm.Check(after.Take(2)[0], 0).Code);
+        }
+        finally { File.Delete(path); }
+    }
