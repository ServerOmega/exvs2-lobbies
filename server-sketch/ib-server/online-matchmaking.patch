+        Assert.Equal(("nat", true), NetDiag.Classify(Net(1, "203.0.113.5", "192.168.1.5"), "26.9.9.9"));
+        Assert.Equal(("stun-missing", false), NetDiag.Classify(Net(1, "", "192.168.1.5"), "26.9.9.9"));
+        Assert.Equal(("nat", false), NetDiag.Classify(Net(1, "203.0.113.5", "192.168.1.5"), "127.0.0.1"));
