+    /// <summary>
+    /// exvs2-lobbies / EXPERIMENTAL (untested with the real game):
+    /// the cabinet uses the SRV_MATCH uri verbatim as the full MMS URL (port ignored) and only starts
+    /// online matching (STUN + IssueNodeId) when an SRV_STUN entry is present.
+    /// </summary>
+    private void AddOnlineMatchingServers(Response.RegisterPcb registerPcb, string baseAddress)
+    {
+        var mm = _config.OnlineMatching;
+        if (!mm.Enabled)
+        {
+            return;
+        }
+
+        var matchUrl = string.IsNullOrWhiteSpace(mm.MatchUrl) ? $"http://{baseAddress}/match" : mm.MatchUrl.Trim();
+        var stunHost = string.IsNullOrWhiteSpace(mm.StunHost) ? HostOnly(baseAddress) : mm.StunHost.Trim();
+
+        registerPcb.ServerInfoes.Clear();
+        registerPcb.ServerInfoes.Add(new Response.RegisterPcb.ServerInfo
+        {
+            ServerType = ServerType.SrvMatch,
+            Uri = matchUrl,
+            Port = 0
+        });
+        var stun = new Response.RegisterPcb.ServerInfo
+        {
+            ServerType = ServerType.SrvStun,
+            Uri = stunHost,
+            Port = mm.StunPort
+        };
+        if (!string.IsNullOrEmpty(mm.StunUser))
+        {
+            stun.AccountName = mm.StunUser;
+            stun.AccountPass = mm.StunPass;
+        }
+        registerPcb.ServerInfoes.Add(stun);
+    }
+
+    private static string HostOnly(string baseAddress)
+    {
+        // "1.2.3.4:28080" -> "1.2.3.4", "[::1]:28080" -> "::1"
+        if (baseAddress.StartsWith('['))
+        {
+            var end = baseAddress.IndexOf(']');
+            return end > 0 ? baseAddress[1..end] : baseAddress;
+        }
+        var colon = baseAddress.LastIndexOf(':');
+        return colon > 0 ? baseAddress[..colon] : baseAddress;
+    }
 }
