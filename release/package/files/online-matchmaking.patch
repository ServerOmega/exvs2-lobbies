diff --git a/Server-Infinite/Matchmaking/Matchmaker.cs b/Server-Infinite/Matchmaking/Matchmaker.cs
new file mode 100644
index 0000000..e26795d
--- /dev/null
+++ b/Server-Infinite/Matchmaking/Matchmaker.cs
@@ -0,0 +1,468 @@
+using nue.protocol.mms;
+
+namespace ServerInfinite.Matchmaking;
+
+/// <summary>
+/// [exvs2-lobbies / EXPERIMENTAL, tested only with fake cabinets, never with the real game]
+/// In-memory 2v2 matchmaker for nue.protocol.mms. C# port of server-sketch/python/mms_server.py.
+///
+/// * One EntryMatching = one <see cref="Unit"/>: a solo sortie (no groups, 1 slot, shuffle candidate) or a
+///   team sortie (partner cabinet "Y" or CPU stand-in "N" in groups[0], 2 slots, never split).
+/// * Buckets: (mucha_game_id, version, world_id, attr1 [, attr2 for "hard"/ranked worlds]).
+/// * Rooms are 2 sides x 2 slots: 4 solos -> random shuffle (ranked: closest levels / even split),
+///   team + 2 solos, team + team. After FillAfter seconds a short-handed room (>= 2 humans) may form.
+/// * Ranked (Class Match G) = worlds 13 (solo) / 14 (team); attr2 = class (hard key), attr4 = level,
+///   level band widens with waiting time.
+/// * group_id (team) is decided here; the cabinet only derives "same team as the first listed client".
+/// </summary>
+public sealed class Matchmaker
+{
+    public const string NpcSerial = "PCB00000NPC";
+    public const int TeamSlots = 2;
+    private const int PoolMax = 12;
+    private const double EndedKeep = 120;      // s a dropped unit's nodes still answer MATCH_CANCELED
+    private const double MatchedKeep = 60;     // s to keep a finished room for late polls
+    private const uint AGroup = 1, AExtra = 2, ALevel = 4;
+
+    // (seconds waited, max |level diff|)
+    private static readonly (double Waited, int MaxLevelDiff)[] RankedBands = { (0, 0), (15, 1), (35, 2), (60, 99) };
+
+    private enum Policy { None, Hard, Soft, Class }
+
+    // world_id -> (name, attr2 policy); source: analysis/casual-shuffle-matching.md + ranked-matching.md
+    private static readonly Dictionary<uint, (string Name, Policy Policy)> Worlds = new()
+    {
+        [5] = ("legacy-mode0", Policy.None),
+        [13] = ("class-solo", Policy.Class), [14] = ("class-team", Policy.Class),
+        [15] = ("instore-solo", Policy.Hard), [16] = ("instore-team", Policy.Hard),
+        [17] = ("shop-setting", Policy.Hard),
+        [18] = ("free-solo", Policy.Soft), [19] = ("free-team", Policy.Soft), [20] = ("free-solo-b", Policy.Soft),
+        [25] = ("free-mixed", Policy.Soft), [23] = ("mix-match", Policy.Soft),
+        [21] = ("mode1", Policy.None), [22] = ("mode2", Policy.None),
+        [6] = ("tag-solo", Policy.Hard), [7] = ("tag-team", Policy.Hard), [24] = ("tag-mixed", Policy.Hard),
+        [26] = ("tag-solo-def", Policy.Hard), [27] = ("tag-team-def", Policy.Hard), [32] = ("tag-mixed-def", Policy.Hard),
+        [33] = ("tag7", Policy.Hard), [8] = ("mode8", Policy.Hard), [9] = ("mode9", Policy.Hard),
+    };
+
+    public sealed record RoomClient(uint GroupId, Client Client);
+
+    public sealed class Room
+    {
+        public uint RoomId { get; init; }
+        public IReadOnlyList<RoomClient> Clients { get; init; } = Array.Empty<RoomClient>();
+        public double At { get; init; }
+        public uint World { get; init; }
+        public int Humans { get; init; }
+    }
+
+    public sealed class Unit
+    {
+        public uint ApplyId;
+        public List<Client> Clients = new();
+        public List<Player> Players = new();
+        public int Slots => Clients.Count;
+        public bool IsTeam => Slots > 1;
+        public uint World;
+        public string WorldName = "";
+        public bool Ranked;
+        public string Key = "";
+        public long? Soft;
+        public long Level;
+        public uint SeqNum, CreateRoom;
+        public HashSet<uint> BlAm = new();
+        public HashSet<string> BlLoc = new();
+        public double Timeout, Created, LastSeen;
+        /// <summary>last CheckMatching per human node (only nodes that polled at least once)</summary>
+        public Dictionary<uint, double> SeenByNode = new();
+        /// <summary>HTTP source IP of each node's own EntryMatching (diagnostics only)</summary>
+        public Dictionary<uint, string> SourceByNode = new();
+        /// <summary>Network realms of the humans ("unknown" ignored); empty = matches any realm.</summary>
+        public HashSet<string> Realms = new();
+        public uint LeaderNode => Clients[0].NodeId;
+        public Room? Room;
+
+        public static Unit From(Request.EntryMatching e, double now)
+        {
+            var u = new Unit
+            {
+                ApplyId = e.ApplyId, Timeout = e.MatchingTimeout == 0 ? 150 : e.MatchingTimeout,
+                Created = now, LastSeen = now, SeqNum = e.SeqNum, CreateRoom = e.CreateRoomFlag,
+            };
+            u.Clients.Add(e.Myclient);
+            u.Players.Add(e.Myplayer ?? new Player());
+            foreach (var g in e.Groups.Take(TeamSlots - 1))   // never more than one partner per side
+            {
+                if (g.Client == null) continue;
+                u.Clients.Add(g.Client);
+                u.Players.Add(g.Player ?? new Player());
+            }
+            var attrs = new Dictionary<uint, long>();
+            foreach (var p in e.Myplayer?.Parameters ?? new List<Player.Parameter>())
+                attrs[p.AttributeId] = p.parameter;
+            u.World = e.World?.WorldId ?? 0;
+            var (name, policy) = Worlds.TryGetValue(u.World, out var w) ? w : ($"world{u.World}", Policy.Hard);
+            u.WorldName = name;
+            u.Ranked = policy == Policy.Class;
+            u.Key = $"{e.World?.MuchaGameId}|{e.World?.Version}|{u.World}|{attrs.GetValueOrDefault(AGroup)}";
+            if (policy is Policy.Class or Policy.Hard) u.Key += $"|{attrs.GetValueOrDefault(AExtra)}";
+            u.Soft = policy == Policy.Soft ? attrs.GetValueOrDefault(AExtra) : null;
+            u.Level = attrs.GetValueOrDefault(ALevel);
+            if (e.BlBanapassportAmIds != null) u.BlAm.UnionWith(e.BlBanapassportAmIds);
+            u.BlLoc.UnionWith(e.BlLocIds.Where(x => x != null));
+            return u;
+        }
+
+        /// <summary>property[0] == "Y" marks a real cabinet; the CPU stand-in is "N" / PCB00000NPC.</summary>
+        public static bool IsHuman(Client c) =>
+            c.Properties.Count > 0 ? c.Properties[0].PropertyValue == "Y" : c.PcbSerial != NpcSerial;
+
+        public IEnumerable<Client> Humans => Clients.Where(IsHuman);
+        public HashSet<uint> NodeIds => Humans.Select(c => c.NodeId).ToHashSet();
+        public HashSet<uint> AmIds => Clients.Zip(Players)
+            .Where(x => IsHuman(x.First) && x.Second.BanapassportAmId != 0)
+            .Select(x => x.Second.BanapassportAmId).ToHashSet();
+        public HashSet<string> Locs => Humans.Select(c => c.LocId ?? "").ToHashSet();
+    }
+
+    private readonly object _gate = new();
+    private readonly Dictionary<uint, Unit> _byNode = new();
+    private readonly List<Unit> _queue = new();
+    private readonly Dictionary<uint, double> _ended = new();   // node -> when its unit was dropped by the server
+    private readonly Random _rng;
+    private uint _nextRoom = 1;
+
+    public double FillAfter { get; set; }
+    public bool AllowPartial { get; set; }
+    public double SoftWait { get; set; }
+    /// <summary>s without CheckMatching (from any of the unit's cabinets) before a waiting unit is dropped.</summary>
+    public double StaleAfter { get; set; } = 20;
+    public Action<string>? Log { get; set; }
+    /// <summary>Warnings (address mismatch, missing STUN result). Falls back to <see cref="Log"/>.</summary>
+    public Action<string>? Warn { get; set; }
+    /// <summary>Also log every CheckMatching result (one line per poll; off by default).</summary>
+    public bool Verbose { get; set; }
+    private readonly HashSet<(string, string)> _warned = new();
+    /// <summary>First node id issued by this process (0 = unknown). An unknown node below it was issued before a
+    /// server restart, so its wait was lost: answer MATCH_CANCELED instead of ERR_MATCH_NOENTRY.</summary>
+    public uint FirstNodeThisRun { get; set; }
+    /// <summary>Network realms (NetDiag.DefaultRealms by default). null = realm matching off: one pool per mode.</summary>
+    public IReadOnlyList<(string Name, string Cidr)>? Realms { get; set; } = NetDiag.DefaultRealms;
+    /// <summary>In-store worlds: only cabinets of one shop may meet (shop code + <see cref="NetDiag.ShopSite"/>).</summary>
+    public static readonly HashSet<uint> InStoreWorlds = new() { 15, 16 };
+    /// <summary>"Site" (default): in-store pool = shop code + shop site; "ShopCode": shop code only (upstream-like).</summary>
+    public string InStoreScope { get; set; } = "Site";
+    /// <summary>Shop overrides: a shop on several public IPs / a range (see OnlineMatching.ShopKeys).</summary>
+    public IReadOnlyList<(string Name, System.Net.IPNetwork Net)> ShopKeys { get; set; } = Array.Empty<(string, System.Net.IPNetwork)>();
+
+    public Matchmaker(double fillAfter = 30, bool allowPartial = true, double softWait = 15, int seed = 0)
+    {
+        FillAfter = fillAfter;
+        AllowPartial = allowPartial;
+        SoftWait = softWait;
+        _rng = seed == 0 ? new Random() : new Random(seed);
+    }
+
+    public int QueueLength { get { lock (_gate) return _queue.Count; } }
+
+    public ErrorCode Entry(Request.EntryMatching e, double now, string? sourceIp = null)
+    {
+        var t = Unit.From(e, now);
+        if (Realms != null)
+            t.Realms = t.Humans.Select(c => NetDiag.Realm(c.GlobalIpaddress, Realms)).Where(r => r != "unknown").ToHashSet();
+        if (InStoreWorlds.Contains(t.World) && !string.Equals(InStoreScope, "ShopCode", StringComparison.OrdinalIgnoreCase))
+            t.Key += "|" + NetDiag.ShopSite(e.Myclient, sourceIp, Realms, ShopKeys);   // different stores never meet
+        if (!string.IsNullOrEmpty(sourceIp)) t.SourceByNode[e.Myclient.NodeId] = NetDiag.Norm(sourceIp);
+        lock (_gate)
+        {
+            Sweep(now);
+            // load test 2026-11-13: a node id held by ANOTHER cabinet (different pcb_serial) must not replace or
+            // merge into that cabinet's entry (node ids are sequential, so guessable).
+            if (e.Myclient.NodeId == 0) return ErrorCode.ErrNodeid;   // never issued by IssueNodeId
+            foreach (var c in t.Humans)
+                if (_byNode.TryGetValue(c.NodeId, out var owner) &&
+                    owner.Clients.Any(x => x.NodeId == c.NodeId && x.PcbSerial != c.PcbSerial))
+                    return ErrorCode.ErrDuplicateEntry;
+            // load test 2026-11-13: a repeated EntryMatching (same node, same apply_id) that arrives after the
+            // unit was matched used to queue a second unit -> the cabinet was put into two rooms.
+            if (_byNode.TryGetValue(e.Myclient.NodeId, out var done) && done.Room != null && done.ApplyId == e.ApplyId)
+            {
+                done.LastSeen = now;
+                return ErrorCode.Success;                              // next CheckMatching returns the same room
+            }
+            foreach (var n in t.NodeIds)
+            {
+                _ended.Remove(n);
+                if (!_byNode.TryGetValue(n, out var old) || old.Room != null) continue;
+                // disconnect test 2026-11-13: the same leader re-entering with a NEW apply_id (e.g. it lost the
+                // connection, came back and picked another mode) was merged into its old entry -> old mode kept.
+                // Merge only the partner's own entry or a retry of the same entry.
+                if (old.NodeIds.SetEquals(t.NodeIds) &&
+                    (e.Myclient.NodeId != old.LeaderNode || e.ApplyId == old.ApplyId))
+                {
+                    // the partner cabinet of a fixed pair sent its own entry: merge into the existing unit
+                    old.LastSeen = now;
+                    if (!string.IsNullOrEmpty(sourceIp)) old.SourceByNode[e.Myclient.NodeId] = NetDiag.Norm(sourceIp);
+                    NetEntry(e.Myclient, sourceIp, "merge");
+                    return ErrorCode.Success;
+                }
+                // re-entry replaces a stale wait. disconnect test 2026-11-13: with a tombstone, so a pair leader
+                // whose partner re-entered solo on the same node is told MATCH_CANCELED (was ERR_MATCH_NOENTRY).
+                Drop(old, now, reason: "replaced by re-entry");
+            }
+            foreach (var n in t.NodeIds) _ended.Remove(n);
+            // load test 2026-11-13: one queue slot per cabinet. A new entry (new node ids) from a cabinet that still
+            // has an older waiting unit (it left without CancelMatching) used to let both match -> two rooms at once.
+            // lm-mix test 2026-11-13: same cabinet = same serial + same global IP (serials repeat across stores).
+            foreach (var old in _queue.Where(u => u.Room == null &&
+                         u.Humans.Any(c2 => t.Humans.Any(c => NetDiag.SameCabinet(c, c2)))).ToList())
+                Drop(old, now, reason: "same cabinet entered again");
+            foreach (var n in t.NodeIds) _byNode[n] = t;
+            _queue.Add(t);
+            NetEntry(e.Myclient, sourceIp, "entry");
+            TryMatch(now);
+            Log?.Invoke($"entry {t.WorldName} nodes=[{string.Join(",", t.NodeIds)}] slots={t.Slots} key={t.Key} level={t.Level} queue={_queue.Count}");
+        }
+        return ErrorCode.Success;
+    }
+
+    public (ErrorCode Code, Room? Room, uint ApplyId) Check(uint nodeId, double now)
+    {
+        var r = CheckCore(nodeId, now);
+        if (Verbose) Log?.Invoke($"check node={nodeId} -> {r.Code} room={r.Room?.RoomId.ToString() ?? "-"}");
+        return r;
+    }
+
+    private (ErrorCode Code, Room? Room, uint ApplyId) CheckCore(uint nodeId, double now)
+    {
+        lock (_gate)
+        {
+            if (_byNode.TryGetValue(nodeId, out var seen))
+            {
+                seen.LastSeen = now;                                        // before Sweep: the poller is alive
+                if (seen.NodeIds.Contains(nodeId)) seen.SeenByNode[nodeId] = now;
+            }
+            Sweep(now);
+            if (!_byNode.TryGetValue(nodeId, out var t))
+                // the unit was ended by its timeout / partner's cancel / staleness / a server restart: tell the
+                // cabinet, not "no entry"
+                return (_ended.Remove(nodeId) || (nodeId != 0 && nodeId < FirstNodeThisRun)
+                    ? ErrorCode.MatchCanceled : ErrorCode.ErrMatchNoentry, null, 0);
+            t.LastSeen = now;
+            if (t.Room == null) TryMatch(now);           // bands widen / fill timer runs with time
+            if (t.Room != null) return (ErrorCode.Success, t.Room, t.ApplyId);
+            if (now - t.Created > t.Timeout)
+            {
+                // disconnect test 2026-11-13: tombstone the polling node too, so a retried poll (response lost)
+                // gets MATCH_CANCELED again instead of ERR_MATCH_NOENTRY
+                Drop(t, now, reason: "matching timeout");
+                return (ErrorCode.MatchCanceled, null, 0);
+            }
+            return (ErrorCode.Success, null, 0);         // empty = keep polling
+        }
+    }
+
+    public void Cancel(uint nodeId, double now = 0, uint applyId = 0)
+    {
+        lock (_gate)
+        {
+            if (!_byNode.TryGetValue(nodeId, out var t) || t.Room != null) return;
+            // disconnect test 2026-11-13: a late / reordered CancelMatching of an OLDER attempt (the leader already
+            // re-entered with a new apply_id) cancelled the current entry. The partner's cancel carries its own
+            // counter, so only the leader's apply_id is checked.
+            if (applyId != 0 && nodeId == t.LeaderNode && applyId != t.ApplyId) return;
+            Drop(t, now, except: nodeId, reason: $"cancelled by node {nodeId}");
+        }
+    }
+
+    /// <summary>One NET line per entry; a warning once per (source, global) pair when STUN and HTTP disagree.</summary>
+    private void NetEntry(Client c, string? sourceIp, string what)
+    {
+        Log?.Invoke($"NET {what} {NetDiag.Describe(c, sourceIp, Realms)}");
+        var (cls, mismatch) = NetDiag.Classify(c, sourceIp);
+        var key = (NetDiag.Norm(sourceIp), NetDiag.Norm(c.GlobalIpaddress));
+        var warn = Warn ?? Log;
+        if (mismatch && _warned.Add(key))
+            warn?.Invoke($"NET-WARN node={c.NodeId} STUN global {key.Item2} != request source {key.Item1}: STUN and this " +
+                         "server were reached by different paths (wrong adapter bound, VPN vs internet, or a proxy) - " +
+                         "peers may not reach this cabinet");
+        else if (cls == "stun-missing" && _warned.Add(("", key.Item1)))
+            warn?.Invoke($"NET-WARN node={c.NodeId} has no STUN global address (STUN unreachable from its bound IP?)");
+    }
+
+    // ---- internals (lock held) ----
+
+    private bool Compatible(Unit a, Unit b, double now)
+    {
+        if (a.Key != b.Key) return false;
+        if (a.NodeIds.Overlaps(b.NodeIds)) return false;                 // same cabinet(s)
+        if (a.AmIds.Overlaps(b.AmIds)) return false;                     // same card twice
+        if (a.BlAm.Overlaps(b.AmIds) || b.BlAm.Overlaps(a.AmIds)) return false;
+        if (a.BlLoc.Overlaps(b.Locs) || b.BlLoc.Overlaps(a.Locs)) return false;
+        if (a.Realms.Count > 0 && b.Realms.Count > 0 && !a.Realms.Overlaps(b.Realms)) return false;   // can't reach each other
+        var waited = now - Math.Min(a.Created, b.Created);              // the longer waiter widens the search
+        if (a.Soft != null && b.Soft != null && a.Soft != b.Soft && waited < SoftWait) return false;
+        if (a.Ranked)
+        {
+            var maxDiff = 0;
+            foreach (var (w, d) in RankedBands) if (waited >= w) maxDiff = d;
+            if (Math.Abs(a.Level - b.Level) > maxDiff) return false;
+        }
+        return true;
+    }
+
+    private static IEnumerable<(List<Unit> S0, List<Unit> S1)> SideSplits(List<Unit> units)
+    {
+        var n = units.Count;
+        for (var mask = 0; mask < 1 << (n - 1); mask++)
+        {
+            var s0 = new List<Unit> { units[0] };
+            var s1 = new List<Unit>();
+            for (var i = 1; i < n; i++) (((mask >> (i - 1)) & 1) == 0 ? s0 : s1).Add(units[i]);
+            if (s1.Count == 0) continue;
+            if (s0.Sum(u => u.Slots) > TeamSlots || s1.Sum(u => u.Slots) > TeamSlots) continue;
+            yield return (s0, s1);
+        }
+    }
+
+    private static IEnumerable<List<Unit>> Combinations(List<Unit> pool, int r, int start = 0)
+    {
+        if (r == 0) { yield return new List<Unit>(); yield break; }
+        for (var i = start; i <= pool.Count - r; i++)
+            foreach (var rest in Combinations(pool, r - 1, i + 1))
+            {
+                rest.Insert(0, pool[i]);
+                yield return rest;
+            }
+    }
+
+    private (double, double, double) Score((List<Unit> S0, List<Unit> S1) sides, Dictionary<Unit, int> idx)
+    {
+        var units = sides.S0.Concat(sides.S1).ToList();
+        double order = units.Sum(u => idx[u]);
+        if (units[0].Ranked)
+        {
+            // most even split by level, then smallest level spread, then FIFO
+            double Avg(List<Unit> s) => s.Sum(u => (double)u.Level * u.Slots) / Math.Max(1, s.Sum(u => u.Slots));
+            var spread = units.Max(u => u.Level) - units.Min(u => u.Level);
+            return (spread * 1000 + Math.Abs(Avg(sides.S0) - Avg(sides.S1)), order, 0);
+        }
+        var softs = units.Where(u => u.Soft != null).Select(u => u.Soft).Distinct().Count();
+        return (Math.Max(0, softs - 1) * 100 + order, _rng.NextDouble(), 0);   // random split = shuffle
+    }
+
+    private (List<Unit>, List<Unit>)? BestRoom(Unit anchor, List<Unit> pool, Dictionary<Unit, int> idx, double now, bool shortHanded)
+    {
+        (double, (double, double, double))? bestScore = null;
+        (List<Unit>, List<Unit>)? best = null;
+        for (var r = 1; r <= Math.Min(3, pool.Count); r++)
+        {
+            foreach (var combo in Combinations(pool, r))
+            {
+                var units = new List<Unit> { anchor };
+                units.AddRange(combo);
+                var slots = units.Sum(u => u.Slots);
+                if (shortHanded)
+                {
+                    if (slots >= 2 * TeamSlots || units.Sum(u => u.Humans.Count()) < 2) continue;
+                }
+                else if (slots != 2 * TeamSlots) continue;
+
+                var ok = true;
+                for (var i = 0; i < units.Count && ok; i++)
+                    for (var j = i + 1; j < units.Count && ok; j++)
+                        ok = Compatible(units[i], units[j], now);
+                if (!ok) continue;
+
+                foreach (var sides in SideSplits(units))
+                {
+                    var s = ((double)(shortHanded ? -slots : 0), Score(sides, idx));
+                    if (bestScore == null || s.CompareTo(bestScore.Value) < 0)
+                    {
+                        bestScore = s;
+                        best = sides;
+                    }
+                }
+            }
+        }
+        return best;
+    }
+
+    private void TryMatch(double now)
+    {
+        bool made;
+        do
+        {
+            made = false;
+            foreach (var bucket in _queue.GroupBy(u => u.Key).Select(g => g.ToList()))
+            {
+                var idx = bucket.Select((u, i) => (u, i)).ToDictionary(x => x.u, x => x.i);
+                for (var i = 0; i < bucket.Count && !made; i++)
+                {
+                    var a = bucket[i];
+                    var pool = bucket.Skip(i + 1).Where(u => Compatible(a, u, now)).Take(PoolMax).ToList();
+                    var sides = BestRoom(a, pool, idx, now, false);
+                    if (sides == null && AllowPartial && now - a.Created >= FillAfter)
+                        sides = BestRoom(a, pool, idx, now, true);
+                    if (sides != null)
+                    {
+                        MakeRoom(sides.Value, now);
+                        made = true;
+                    }
+                }
+                if (made) break;
+            }
+        } while (made);
+    }
+
+    private void MakeRoom((List<Unit> S0, List<Unit> S1) sides, double now)
+    {
+        var clients = new List<RoomClient>();
+        foreach (var u in sides.S0) clients.AddRange(u.Clients.Select(c => new RoomClient(0, c)));
+        foreach (var u in sides.S1) clients.AddRange(u.Clients.Select(c => new RoomClient(1, c)));
+        var all = sides.S0.Concat(sides.S1).ToList();
+        var room = new Room
+        {
+            RoomId = _nextRoom++, Clients = clients, At = now, World = all[0].World,
+            Humans = all.Sum(u => u.Humans.Count()),
+        };
+        foreach (var u in all)
+        {
+            _queue.Remove(u);
+            u.Room = room;
+        }
+        string Desc(List<Unit> s) => string.Join("+", s.Select(u => $"{(u.IsTeam ? "T" : "S")}[{string.Join(",", u.NodeIds)}]"));
+        Log?.Invoke($"MATCH room={room.RoomId} {all[0].WorldName} {Desc(sides.S0)} vs {Desc(sides.S1)} (humans={room.Humans}/4)");
+        var src = new Dictionary<uint, string>();
+        foreach (var u in all) foreach (var kv in u.SourceByNode) src[kv.Key] = kv.Value;
+        Log?.Invoke(NetDiag.MatchLine(room.RoomId, clients.Select(c => (c.GroupId, c.Client)), src, Realms));
+    }
+
+    /// <summary>Remove a unit. With <paramref name="now"/>, its other human nodes (e.g. the partner of a
+    /// fixed pair) get MATCH_CANCELED on their next poll instead of ERR_MATCH_NOENTRY.</summary>
+    private void Drop(Unit t, double? now = null, uint? except = null, string? reason = null)
+    {
+        if (reason != null) Log?.Invoke($"drop nodes=[{string.Join(",", t.NodeIds)}] reason={reason}");
+        if (now != null)
+            foreach (var n in t.NodeIds)
+                if (n != except && _byNode.TryGetValue(n, out var u) && ReferenceEquals(u, t)) _ended[n] = now.Value;
+        _queue.Remove(t);
+        foreach (var k in _byNode.Where(kv => ReferenceEquals(kv.Value, t)).Select(kv => kv.Key).ToList())
+            _byNode.Remove(k);
+    }
+
+    private void Sweep(double now)
+    {
+        foreach (var t in _byNode.Values.Distinct().ToList())
+        {
+            // load test 2026-11-13: was LastSeen > StaleAfter + Timeout, so a cabinet that stopped polling stayed
+            // matchable for ~170 s and was put into rooms as a ghost.
+            // disconnect test 2026-11-13: staleness per cabinet. With one LastSeen per unit, the partner's polls
+            // kept a pair whose leader had vanished (or vice versa) matchable -> ghost in the room.
+            if (t.Room == null && (now - t.LastSeen > StaleAfter || t.SeenByNode.Values.Any(s => now - s > StaleAfter)))
+                Drop(t, now, reason: "stopped polling (stale)");
+            else if (t.Room != null && now - t.Room.At > MatchedKeep) Drop(t);
+        }
+        foreach (var n in _ended.Where(kv => now - kv.Value > EndedKeep).Select(kv => kv.Key).ToList())
+            _ended.Remove(n);
+    }
+}
diff --git a/Server-Infinite/Matchmaking/NetDiag.cs b/Server-Infinite/Matchmaking/NetDiag.cs
new file mode 100644
index 0000000..7403d44
--- /dev/null
+++ b/Server-Infinite/Matchmaking/NetDiag.cs
@@ -0,0 +1,133 @@
+using nue.protocol.mms;
+
+namespace ServerInfinite.Matchmaking;
+
+/// <summary>
+/// [exvs2-lobbies / EXPERIMENTAL] Address / NAT diagnostics for the log (analysis/networking-issues.md §6).
+/// Only node ids, IPs, ports and NAT types are printed: never pcb_serial values or card data.
+/// </summary>
+public static class NetDiag
+{
+    public static string Norm(string? ip)
+    {
+        var s = (ip ?? "").Trim();
+        return s.StartsWith("::ffff:", StringComparison.OrdinalIgnoreCase) ? s[7..] : s;   // IPv4-mapped source
+    }
+
+    /// <summary>Default network realms (analysis/lm-and-online.md): cabinets whose STUN global IP is in different
+    /// realms can't reach each other and are never put in one room. Anything not listed = "internet".</summary>
+    public static readonly IReadOnlyList<(string Name, string Cidr)> DefaultRealms = new[]
+    {
+        ("radmin", "26.0.0.0/8"), ("hamachi", "25.0.0.0/8"), ("cgnat-overlay", "100.64.0.0/10"),
+        ("lan", "10.0.0.0/8"), ("lan", "172.16.0.0/12"), ("lan", "192.168.0.0/16"), ("lan", "127.0.0.0/8"),
+    };
+
+    /// <summary>"name=cidr,name=cidr" -> realms; "" = defaults; "off" / "none" = realm matching disabled (null).</summary>
+    public static IReadOnlyList<(string Name, string Cidr)>? ParseRealms(string? spec)
+    {
+        if (string.IsNullOrWhiteSpace(spec)) return DefaultRealms;
+        if (spec.Trim().ToLowerInvariant() is "off" or "none") return null;
+        return spec.Split(',').Select(x => x.Split('=', 2)).Where(x => x.Length == 2)
+            .Select(x => (x[0].Trim(), x[1].Trim())).ToList();
+    }
+
+    /// <summary>"unknown" (no STUN address), the first realm containing the IP, or "internet".</summary>
+    public static string Realm(string? ip, IReadOnlyList<(string Name, string Cidr)>? realms = null)
+    {
+        var s = Norm(ip);
+        if (s is "" or "0.0.0.0" || !System.Net.IPAddress.TryParse(s, out var a)) return "unknown";
+        foreach (var (name, cidr) in realms ?? DefaultRealms)
+            if (System.Net.IPNetwork.TryParse(cidr, out var net) && net.Contains(a)) return name;
+        return "internet";
+    }
+
+    /// <summary>pcb_serial alone is not unique across stores / homes (the POC hook defaults every install to serial
+    /// 0001). Same cabinet = same serial and same STUN global IP; serial only when either has no global IP.</summary>
+    public static bool SameCabinet(Client a, Client b)
+    {
+        if (string.IsNullOrEmpty(a.PcbSerial) || a.PcbSerial != b.PcbSerial) return false;
+        string ga = Norm(a.GlobalIpaddress), gb = Norm(b.GlobalIpaddress);
+        return ga is "" or "0.0.0.0" || gb is "" or "0.0.0.0" || ga == gb;
+    }
+
+    /// <summary>"SHOPA=203.0.113.10/32 203.0.113.11/32,SHOPB=198.51.100.0/28" -> (name, network) list.</summary>
+    public static List<(string Name, System.Net.IPNetwork Net)> ParseShopKeys(string? spec)
+    {
+        var list = new List<(string, System.Net.IPNetwork)>();
+        foreach (var part in (spec ?? "").Split(','))
+        {
+            var kv = part.Split('=', 2);
+            if (kv.Length != 2) continue;
+            foreach (var c in kv[1].Split(' ', StringSplitOptions.RemoveEmptyEntries))
+                if (System.Net.IPNetwork.TryParse(c.Trim(), out var net)) list.Add((kv[0].Trim(), net));
+        }
+        return list;
+    }
+
+    /// <summary>Which shop a cabinet is in, for in-store match. The shop code it sends (from loc_id) is the same on
+    /// every POC install (place_id JPN1), but a store's cabinets share one public IP. Order: configured shop key >
+    /// STUN public IP (internet realm) > realm name (LAN / overlay STUN = one virtual store) > HTTP source > unknown.</summary>
+    public static string ShopSite(Client c, string? source, IReadOnlyList<(string Name, string Cidr)>? realms,
+        IReadOnlyList<(string Name, System.Net.IPNetwork Net)> shopKeys)
+    {
+        string g = Norm(c.GlobalIpaddress), src = Norm(source);
+        foreach (var ip in new[] { g, src })
+            if (System.Net.IPAddress.TryParse(ip, out var a))
+                foreach (var (name, net) in shopKeys)
+                    if (net.Contains(a)) return "shop:" + name;
+        var r = realms != null ? Realm(g, realms) : g is "" or "0.0.0.0" ? "unknown" : "internet";
+        if (r == "internet") return "ip:" + g;
+        if (r != "unknown") return "realm:" + r;
+        return src != "" ? "src:" + src : "unknown";
+    }
+
+    private static bool IsLoopback(string ip) => ip.StartsWith("127.") || ip is "::1" or "localhost";
+
+    /// <summary>Class: "no-nat" (STUN global == adapter local), "nat", "stun-missing". Mismatch: STUN global IP
+    /// differs from the IP the HTTP request came from (loopback sources are ignored).</summary>
+    public static (string Class, bool Mismatch) Classify(Client c, string? source)
+    {
+        string g = Norm(c.GlobalIpaddress), l = Norm(c.LocalIpaddress), src = Norm(source);
+        var cls = g is "" or "0.0.0.0" ? "stun-missing" : g == l ? "no-nat" : "nat";
+        return (cls, src != "" && cls != "stun-missing" && g != src && !IsLoopback(src));
+    }
+
+    public static string Describe(Client c, string? source, IReadOnlyList<(string Name, string Cidr)>? realms = null)
+    {
+        var (cls, mismatch) = Classify(c, source);
+        return $"node={c.NodeId} src={(Norm(source) is var s && s != "" ? s : "-")} " +
+               $"local={Or(c.LocalIpaddress)}:{c.LocalPort} global={Or(c.GlobalIpaddress)}:{c.GlobalPort} " +
+               $"nat={(int)c.NatMappingType}/{(int)c.NatFilteringType} class={cls} realm={Realm(c.GlobalIpaddress, realms)}" +
+               $"{(mismatch ? " MISMATCH" : "")}";
+    }
+
+    /// <summary>What <paramref name="me"/> dials for <paramref name="peer"/> (exe 0x140794590): the peer's local
+    /// ip:port when both STUN global IPs are equal, else its global ip:port.</summary>
+    public static (string How, string Addr) DialAddr(Client me, Client peer)
+    {
+        var g = Norm(me.GlobalIpaddress);
+        return g != "" && g == Norm(peer.GlobalIpaddress)
+            ? ("local", $"{Or(peer.LocalIpaddress)}:{peer.LocalPort}")
+            : ("global", $"{Or(peer.GlobalIpaddress)}:{peer.GlobalPort}");
+    }
+
+    /// <summary>One line per room: every human's addresses and, for each human pair, which path is used.</summary>
+    public static string MatchLine(uint roomId, IEnumerable<(uint Group, Client Client)> clients,
+        IReadOnlyDictionary<uint, string> sourceByNode, IReadOnlyList<(string Name, string Cidr)>? realms = null)
+    {
+        var hs = clients.Where(x => Matchmaker.Unit.IsHuman(x.Client)).ToList();
+        var parts = hs.Select(x => $"g{x.Group} {Describe(x.Client, sourceByNode.GetValueOrDefault(x.Client.NodeId), realms)}");
+        var pairs = new List<string>();
+        for (var i = 0; i < hs.Count; i++)
+            for (var j = i + 1; j < hs.Count; j++)
+            {
+                Client a = hs[i].Client, b = hs[j].Client;
+                var (how, ab) = DialAddr(a, b);
+                var (_, ba) = DialAddr(b, a);
+                pairs.Add($"{a.NodeId}<->{b.NodeId} {how}{(how == "local" ? " same-NAT" : "")} ({ab} / {ba})");
+            }
+        return $"MATCH-NET room={roomId} | {string.Join(" ; ", parts)} | pairs: {(pairs.Count > 0 ? string.Join(" ; ", pairs) : "-")}";
+    }
+
+    private static string Or(string? s) => string.IsNullOrEmpty(s) ? "-" : s;
+}
diff --git a/Server-Infinite/Matchmaking/NodeIdAllocator.cs b/Server-Infinite/Matchmaking/NodeIdAllocator.cs
new file mode 100644
index 0000000..03a0d93
--- /dev/null
+++ b/Server-Infinite/Matchmaking/NodeIdAllocator.cs
@@ -0,0 +1,61 @@
+using System.Text.Json;
+
+namespace ServerInfinite.Matchmaking;
+
+/// <summary>
+/// [exvs2-lobbies / EXPERIMENTAL] Monotonic, persisted, globally unique MMS node ids.
+/// The cabinet asks for issue_count = 2 and rejects replies with fewer ids; it finds itself in the
+/// CheckMatching client list by node_id equality, so ids must never repeat (also across restarts).
+/// </summary>
+public interface INodeIdAllocator
+{
+    uint[] Take(int count);
+}
+
+public sealed class FileNodeIdAllocator : INodeIdAllocator
+{
+    private readonly object _gate = new();
+    private readonly string? _path;
+    private uint _next;
+    /// <summary>First id this process hands out if earlier ids were issued before (state file found), else 0.</summary>
+    public uint FirstThisRun { get; }
+
+    public FileNodeIdAllocator(string? path, uint start = 1000)
+    {
+        _path = string.IsNullOrWhiteSpace(path) ? null : path;
+        _next = start;
+        if (_path != null && File.Exists(_path))
+        {
+            try
+            {
+                using var doc = JsonDocument.Parse(File.ReadAllText(_path));
+                if (doc.RootElement.TryGetProperty("next_node_id", out var v))
+                {
+                    _next = Math.Max(start, v.GetUInt32());
+                    FirstThisRun = _next;
+                }
+            }
+            catch (Exception)
+            {
+                // corrupt state file: keep going from `start`; uniqueness within this run still holds
+            }
+        }
+    }
+
+    public uint[] Take(int count)
+    {
+        count = Math.Clamp(count, 1, 16);
+        lock (_gate)
+        {
+            var ids = new uint[count];
+            for (var i = 0; i < count; i++) ids[i] = _next++;
+            if (_path != null)
+            {
+                var tmp = _path + ".tmp";
+                File.WriteAllText(tmp, JsonSerializer.Serialize(new Dictionary<string, uint> { ["next_node_id"] = _next }));
+                File.Move(tmp, _path, overwrite: true);
+            }
+            return ids;
+        }
+    }
+}
