+using nue.protocol.mms;
+using ServerInfinite.Matchmaking;
+using Xunit;
+
+namespace Matchmaking.Tests;
+
+// Online tag (world 5) and partner recruit (worlds 21 / 22). EXPERIMENTAL: entry shapes follow static analysis of
+// vsac29 (analysis/partner-invites.md), never a live capture.
+public class OnlineTagTests
+{
+    private uint _node = 500;
+
+    private static Client Cl(uint node, string serial, string ip = "")
+    {
+        var c = new Client
+        {
+            NodeId = node, PcbSerial = serial, LocId = $"L{serial}", PrefCode = 13, GlobalIpaddress = ip,
+            NatMappingType = NatMappingType.NmEndpointIndependent, NatFilteringType = NatFilteringType.NfEndpointIndependent
+        };
+        c.Properties.Add(new Client.Property { PropertyId = 0, PropertyValue = "Y" });
+        return c;
+    }
+
+    /// <summary>What CAcSeqWanTagEntry sends: attr2 = min(own pilot id, partner id), am_id = own pilot id.</summary>
+    private Request.EntryMatching Tag(uint pilot, uint partner, uint timeout = 90, string? serial = null, uint? node = null)
+        => Solo(Matchmaker.OnlineTagWorld, Math.Min(pilot, partner), pilot, timeout, serial, node);
+
+    private Request.EntryMatching Solo(uint world, long attr2, uint am, uint timeout = 150, string? serial = null, uint? node = null,
+        uint applyId = 1)
+    {
+        var n = node ?? ++_node;
+        var e = new Request.EntryMatching
+        {
+            ApplyId = applyId, Myclient = Cl(n, serial ?? $"P{n}"), MatchingTimeout = timeout,
+            Myplayer = new Player { BanapassportAmId = am },
+            World = new World { MuchaGameId = "GIB1", Version = 1, WorldId = world }
+        };
+        e.Myplayer.Parameters.Add(new Player.Parameter { AttributeId = 1, parameter = 0 });
+        e.Myplayer.Parameters.Add(new Player.Parameter { AttributeId = 2, parameter = attr2 });
+        e.Myplayer.Parameters.Add(new Player.Parameter { AttributeId = 3, parameter = 0 });
+        return e;
+    }
+
+    /// <summary>The leader's team entry after the pair formed: Mix team (world 23) with the partner as "Y" group.</summary>
+    private static Request.EntryMatching TeamEntry(Request.EntryMatching leader, Request.EntryMatching member, uint world = 23,
+        uint applyId = 2)
+    {
+        var e = new Request.EntryMatching
+        {
+            ApplyId = applyId, Myclient = leader.Myclient, MatchingTimeout = 150,
+            Myplayer = new Player { BanapassportAmId = leader.Myplayer.BanapassportAmId },
+            World = new World { MuchaGameId = "GIB1", Version = 1, WorldId = world }
+        };
+        // Mix: attr2 = veteran flag (not the pair key any more)
+        e.Myplayer.Parameters.Add(new Player.Parameter { AttributeId = 1, parameter = 0 });
+        e.Myplayer.Parameters.Add(new Player.Parameter { AttributeId = 2, parameter = 0 });
+        e.Groups.Add(new Request.EntryMatching.Group { Client = member.Myclient, Player = member.Myplayer });
+        return e;
+    }
+
+    private static Matchmaker New(bool cpu = false) =>
+        new(fillAfter: 3, allowPartial: true, softWait: 15, seed: 1) { StaleAfter = 1e6, CpuStandIns = cpu };
+
+    private static uint Node(Request.EntryMatching e) => e.Myclient.NodeId;
+
+    [Fact]
+    public void TwoTagPartnersPairOnTheSameSide()
+    {
+        var mm = New();
+        var a = Tag(20, 10);          // entered first, but pilot 10 is the leader (own id < partner id)
+        var b = Tag(10, 20);
+        Assert.Equal(ErrorCode.Success, mm.Entry(a, 0));
+        Assert.Equal(ErrorCode.Success, mm.Entry(b, 1));
+        var (code, room, _) = mm.Check(Node(a), 2);
+        Assert.Equal(ErrorCode.Success, code);
+        Assert.NotNull(room);
+        Assert.Equal(2, room!.Clients.Count);
+        Assert.All(room.Clients, c => Assert.Equal(0u, c.GroupId));
+        Assert.Equal(new[] { Node(b), Node(a) }, room.Clients.Select(c => c.Client.NodeId));   // leader (lower id) first
+        Assert.Same(room, mm.Check(Node(b), 2).Room);                                           // same list for both
+        Assert.All(room.Clients, c => Assert.True(Matchmaker.Unit.IsHuman(c.Client)));
+        Assert.Equal(0, mm.QueueLength);
+    }
+
+    [Fact]
+    public void OrderDoesNotDependOnArrival()
+    {
+        var mm = New();
+        var lo = Tag(3, 7); var hi = Tag(7, 3);
+        mm.Entry(lo, 0); mm.Entry(hi, 0);
+        Assert.Equal(Node(lo), mm.Check(Node(hi), 1).Room!.Clients[0].Client.NodeId);
+    }
+
+    [Fact]
+    public void MismatchedPairKeysNeverPairAndTimeOutWithCancel()
+    {
+        var mm = New();
+        var a = Tag(10, 20);        // key 10
+        var c = Tag(30, 40);        // key 30
+        mm.Entry(a, 0); mm.Entry(c, 0);
+        for (var t = 1; t <= 89; t += 4)
+        {
+            Assert.Null(mm.Check(Node(a), t).Room);
+            Assert.Null(mm.Check(Node(c), t).Room);
+        }
+        Assert.Equal(ErrorCode.MatchCanceled, mm.Check(Node(a), 91).Code);   // the cabinet's own 90 s
+        Assert.Equal(ErrorCode.MatchCanceled, mm.Check(Node(c), 91).Code);
+        Assert.Equal(ErrorCode.MatchCanceled, mm.Check(Node(a), 92).Code);   // a retried poll too
+    }
+
+    [Fact]
+    public void TagEntryWithoutTimeoutUses90Seconds()
+    {
+        var mm = New();
+        var a = Tag(10, 20, timeout: 0);
+        mm.Entry(a, 0);
+        Assert.Equal(ErrorCode.Success, mm.Check(Node(a), 89).Code);
+        Assert.Equal(ErrorCode.MatchCanceled, mm.Check(Node(a), 91).Code);
+        var r = Solo(Matchmaker.CasualRecruitWorld, 0, 5, timeout: 0);
+        mm.Entry(r, 100);
+        Assert.Equal(ErrorCode.Success, mm.Check(Node(r), 249).Code);
+        Assert.Equal(ErrorCode.MatchCanceled, mm.Check(Node(r), 251).Code);
+    }
+
+    [Fact]
+    public void ALoneTagEntryNeverGetsAShortRoomOrCpu()
+    {
+        var mm = New(cpu: true);
+        var a = Tag(10, 20);
+        var solo23 = Solo(23, 0, 77);
+        mm.Entry(a, 0); mm.Entry(solo23, 0);
+        Assert.Null(mm.Check(Node(a), 60).Room);
+        Assert.Null(mm.Check(Node(solo23), 60).Room);   // a different world, never mixed in
+        var b = Tag(20, 10);
+        mm.Entry(b, 61);
+        var room = mm.Check(Node(b), 62).Room!;
+        Assert.Equal(2, room.Clients.Count);
+        Assert.DoesNotContain(room.Clients, c => c.Client.PcbSerial == Matchmaker.NpcSerial);
+    }
+
+    [Fact]
+    public void ThirdCabinetWithTheSameKeyWaits()
+    {
+        var mm = New();
+        var a = Tag(10, 20); var b = Tag(20, 10); var x = Tag(10, 20);
+        mm.Entry(a, 0); mm.Entry(b, 0); mm.Entry(x, 0);
+        Assert.NotNull(mm.Check(Node(a), 1).Room);
+        Assert.Null(mm.Check(Node(x), 1).Room);
+        Assert.Equal(1, mm.QueueLength);
+    }
+
+    [Fact]
+    public void PairKeyZeroNeverPairs()
+    {
+        var mm = New();
+        var a = Solo(Matchmaker.OnlineTagWorld, 0, 1, 90); var b = Solo(Matchmaker.OnlineTagWorld, 0, 2, 90);
+        mm.Entry(a, 0); mm.Entry(b, 0);
+        Assert.Null(mm.Check(Node(a), 30).Room);
+    }
+
+    [Fact]
+    public void NeverMatchListsAreRespected()
+    {
+        var mm = New();
+        var a = Tag(10, 20); var b = Tag(20, 10);
+        a.BlBanapassportAmIds = new uint[] { 20 };
+        mm.Entry(a, 0); mm.Entry(b, 0);
+        Assert.Null(mm.Check(Node(a), 1).Room);
+        var r1 = Solo(Matchmaker.CasualRecruitWorld, 0, 31); var r2 = Solo(Matchmaker.CasualRecruitWorld, 0, 32);
+        r2.BlLocIds.Add(r1.Myclient.LocId);
+        mm.Entry(r1, 0); mm.Entry(r2, 0);
+        Assert.Null(mm.Check(Node(r1), 1).Room);
+    }
+
+    [Fact]
+    public void SameCardOrCabinetNeverPairsWithItself()
+    {
+        var mm = New();
+        var a = Tag(10, 20); var b = Tag(10, 20);   // same card (am 10) on two cabinets
+        mm.Entry(a, 0); mm.Entry(b, 0);
+        Assert.Null(mm.Check(Node(a), 1).Room);
+        var mm2 = New();
+        var c = Solo(Matchmaker.CasualRecruitWorld, 0, 41, serial: "SAME1");
+        var d = Solo(Matchmaker.CasualRecruitWorld, 0, 42, serial: "SAME1");
+        mm2.Entry(c, 0); mm2.Entry(d, 0);           // same cabinet re-entered: the old wait is dropped
+        Assert.Null(mm2.Check(Node(d), 1).Room);
+        Assert.Equal(1, mm2.QueueLength);
+    }
+
+    [Fact]
+    public void TeamEntryInAPairWorldIsRefused()
+    {
+        var mm = New();
+        var a = Tag(10, 20); var b = Tag(20, 10);
+        Assert.Equal(ErrorCode.ErrMatchCondition, mm.Entry(TeamEntry(a, b, world: Matchmaker.OnlineTagWorld), 0));
+        Assert.Equal(0, mm.QueueLength);
+    }
+
+    [Fact]
+    public void CancelEndsTheWaitAndAPartnerArrivingLaterFindsNobody()
+    {
+        var mm = New();
+        var a = Tag(10, 20);
+        mm.Entry(a, 0);
+        mm.Cancel(Node(a), 5, a.ApplyId);
+        var b = Tag(20, 10);
+        mm.Entry(b, 6);
+        Assert.Null(mm.Check(Node(b), 7).Room);
+        Assert.Equal(ErrorCode.ErrMatchNoentry, mm.Check(Node(a), 7).Code);   // own cancel: no tombstone needed
+    }
+
+    [Fact]
+    public void CasualRecruitIsFirstComeFirstPaired()
+    {
+        var mm = New();
+        var r = Enumerable.Range(0, 3).Select(i => Solo(Matchmaker.CasualRecruitWorld, i, (uint)(50 + i))).ToList();
+        r.ForEach(e => mm.Entry(e, 0));
+        var room = mm.Check(Node(r[0]), 1).Room!;
+        Assert.Equal(new[] { Node(r[0]), Node(r[1]) }, room.Clients.Select(c => c.Client.NodeId));
+        Assert.All(room.Clients, c => Assert.Equal(0u, c.GroupId));
+        Assert.Null(mm.Check(Node(r[2]), 1).Room);
+        Assert.Null(mm.Check(Node(r[2]), 100).Room);            // no short room / fill, ever
+    }
+
+    [Fact]
+    public void RankedRecruitPairsOnlyTheSameClass()
+    {
+        var mm = New();
+        var c2 = Solo(Matchmaker.RankedRecruitWorld, 2, 61); var c3 = Solo(Matchmaker.RankedRecruitWorld, 3, 62);
+        mm.Entry(c2, 0); mm.Entry(c3, 0);
+        Assert.Null(mm.Check(Node(c2), 100).Room);
+        var c2b = Solo(Matchmaker.RankedRecruitWorld, 2, 63);
+        mm.Entry(c2b, 101);
+        Assert.Equal(2, mm.Check(Node(c2), 102).Room!.Clients.Count);
+        Assert.Null(mm.Check(Node(c3), 102).Room);
+    }
+
+    [Fact]
+    public void RecruitAndTagNeverMix()
+    {
+        var mm = New();
+        var t = Tag(10, 20); var r = Solo(Matchmaker.CasualRecruitWorld, 10, 20);
+        mm.Entry(t, 0); mm.Entry(r, 0);
+        Assert.Null(mm.Check(Node(t), 1).Room);
+    }
+
+    [Fact]
+    public void TwoTagPairsThenMatchEachOther2v2()
+    {
+        var mm = New();
+        // pair 1: pilots 10 + 20; pair 2: pilots 30 + 40
+        var a1 = Tag(10, 20); var a2 = Tag(20, 10); var b1 = Tag(30, 40); var b2 = Tag(40, 30);
+        foreach (var e in new[] { a1, b1, a2, b2 }) Assert.Equal(ErrorCode.Success, mm.Entry(e, 0));
+        var p1 = mm.Check(Node(a1), 1).Room!; var p2 = mm.Check(Node(b1), 1).Room!;
+        Assert.NotSame(p1, p2);
+        Assert.Equal(new[] { Node(a1), Node(a2) }.OrderBy(x => x), p1.Clients.Select(c => c.Client.NodeId).OrderBy(x => x));
+        Assert.Equal(new[] { Node(b1), Node(b2) }.OrderBy(x => x), p2.Clients.Select(c => c.Client.NodeId).OrderBy(x => x));
+
+        // only the leaders send a team entry (same node; apply_id re-used on purpose: must not get the old pair room)
+        Assert.Equal(ErrorCode.Success, mm.Entry(TeamEntry(a1, a2, applyId: a1.ApplyId), 10));
+        var wait = mm.Check(Node(a2), 11);                     // the member polls: now the team search, still waiting
+        Assert.Equal(ErrorCode.Success, wait.Code);
+        Assert.Null(wait.Room);
+        Assert.Equal(ErrorCode.Success, mm.Entry(TeamEntry(b1, b2), 12));
+        var room = mm.Check(Node(a1), 13).Room!;
+        Assert.Equal(4, room.Clients.Count);
+        foreach (var n in new[] { a1, a2, b1, b2 }) Assert.Same(room, mm.Check(Node(n), 13).Room);
+        uint G(Request.EntryMatching e) => room.Clients.Single(c => c.Client.NodeId == Node(e)).GroupId;
+        Assert.Equal(G(a1), G(a2));
+        Assert.Equal(G(b1), G(b2));
+        Assert.NotEqual(G(a1), G(b1));
+    }
+}
