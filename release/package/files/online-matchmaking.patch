+    /// <summary>
+    /// exvs2-lobbies / EXPERIMENTAL (untested with the real game): Class Match G (OMM_CLASS) results.
+    /// The cabinet computes the new rate/grade/class itself and uploads them; the server only stores them and
+    /// returns them in the next PreLoadCard (rate_*, class_id_*, grade_*, class_*_win/lose).
+    /// shuffle_flag = solo (shuffle) class record, otherwise the team record.
+    /// </summary>
+    private void SaveClassMatchResult(CardProfile cardProfile, Request.SaveVsmOnResult save)
+    {
+        var result = save.Result;
+        if (result.OnlineMatchingMode != OnlineMatchingMode.OmmClass || result.class_match_result == null)
+        {
+            return;
+        }
+        var cmr = result.class_match_result;
+        var solo = save.ShuffleFlag;
+        BaseClassMatchRecord? record = solo
+            ? _context.SoloClassMatchRecordDbSet.FirstOrDefault(x => x.CardProfile == cardProfile)
+            : _context.TeamClassMatchRecordDbSet.FirstOrDefault(x => x.CardProfile == cardProfile);
+        if (record == null)
+        {
+            _logger.LogWarning("SaveVsmOnResult class match: no {Kind} class record for card {CardId}", solo ? "solo" : "team", cardProfile.Id);
+            return;
+        }
+
+        var newClass = solo ? cmr.ClassIdSolo : cmr.ClassIdTeam;
+        var rate = cmr.AfterRate;
+        if (!float.IsFinite(rate) || rate < 0f || rate > 100000f)
+        {
+            _logger.LogWarning("SaveVsmOnResult class match: ignoring implausible after_rate {Rate}", rate);
+            rate = record.Rate;
+        }
+
+        if (newClass is >= 1 and <= 4)
+        {
+            record.ClassChangeStatus = newClass > record.ClassId ? 1u : newClass < record.ClassId ? 2u : 0u;
+            record.ClassId = newClass;
+        }
+        record.Rate = rate;
+        if (cmr.GradeId is >= 1 and <= 10)
+        {
+            record.Grade = cmr.GradeId;
+        }
+        record.WeeklyTotalBattleCount++;
+        if (result.WinFlag)
+        {
+            record.WeeklyTotalWinCount++;
+        }
+
+        var winLoss = _context.WinLossRecordDbSet.FirstOrDefault(x => x.CardProfile == cardProfile);
+        if (winLoss != null)
+        {
+            if (solo)
+            {
+                if (result.WinFlag) winLoss.ClassSoloWin++; else winLoss.ClassSoloLose++;
+            }
+            else
+            {
+                if (result.WinFlag) winLoss.ClassTeamWin++; else winLoss.ClassTeamLose++;
+            }
+        }
+
+        _logger.LogInformation(
+            "SaveVsmOnResult class match card={CardId} {Kind} room={RoomId} win={Win} class={Class} grade={Grade} rate {Before}->{After} ({Obtained:+0.##;-0.##})",
+            cardProfile.Id, solo ? "solo" : "team", result.RoomId, result.WinFlag, record.ClassId, cmr.GradeId,
+            cmr.BeforeRate, record.Rate, cmr.ObtainedRate);
+    }
 }
