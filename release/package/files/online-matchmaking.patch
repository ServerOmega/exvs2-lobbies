+using nue.protocol.exvs;
+using ServerInfinite.Models.Cards;
+using ServerInfinite.Models.Config;
+using ServerInfinite.Persistence;
+using ServerInfinite.Strategy.Team;
+
+namespace ServerInfinite.Commands.LoadCard.MobileUser;
+
+/// <summary>
+/// [exvs2-lobbies / EXPERIMENTAL] LoadCard.MobileUserGroup.tag_teams (36): the list the online-tag (オンラインタッグ)
+/// menu most likely shows (partner-invites.md 4). Upstream never filled it, so online tag had nobody to pick.
+/// </summary>
+public class OnlineTagTeamsCommand : ILoadCardMobileUserCommand
+{
+    private readonly ServerDbContext _context;
+    private readonly OnlineTagConfigurations _cfg;
+    private readonly ILogger? _logger;
+
+    public OnlineTagTeamsCommand(ServerDbContext context, OnlineTagConfigurations cfg, ILogger? logger = null)
+    {
+        _context = context;
+        _cfg = cfg;
+        _logger = logger;
+    }
+
+    public void Fill(CardProfile cardProfile, Response.LoadCard.MobileUserGroup mobileUserGroup)
+    {
+        if (!_cfg.SendTagTeams) return;
+        var teams = OnlineTagTeamList.Build(_context, cardProfile, _cfg);
+        mobileUserGroup.TagTeams.AddRange(teams);
+        _logger?.LogInformation("LoadCard online tag: CardId={CardId} tag_teams={Count} tag_status={Status} [{Teams}]",
+            cardProfile.Id, teams.Count, _cfg.TagStatus,
+            string.Join(", ", teams.Select(t => $"team {t.Id} partner {t.PartnerId} key {Math.Min(OnlineTagTeamList.WirePilotId(cardProfile.Id), t.PartnerId)}")));
+    }
+}
