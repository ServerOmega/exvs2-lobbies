Subject: [PATCH 02/11] RegisterCard: fall back to pending card by access code
 when SessionId is empty (POC clients)

---
 .../Handlers/Game/RegisterCardCommandHandler.cs     | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/Server-Infinite/Handlers/Game/RegisterCardCommandHandler.cs b/Server-Infinite/Handlers/Game/RegisterCardCommandHandler.cs
index da8f5ea..3029cb0 100644
--- a/Server-Infinite/Handlers/Game/RegisterCardCommandHandler.cs
+++ b/Server-Infinite/Handlers/Game/RegisterCardCommandHandler.cs
@@ -32,6 +32,19 @@ public class RegisterCardCommandHandler : IRequestHandler<RegisterCardCommand, R
         var cardProfile = _context.CardProfiles
             .FirstOrDefault(x => x.AccessCode == registerCardRequest.AccessCode && x.SessionId == registerCardRequest.SessionId);
 
+        // Some clients (POC/SnowLauncher builds) send register_card with an empty SessionId.
+        // Fall back to the pending new card with the same access code (and chip id when sent).
+        if (cardProfile == null && string.IsNullOrEmpty(registerCardRequest.SessionId))
+        {
+            var chipId = registerCardRequest.ChipId;
+            cardProfile = _context.CardProfiles
+                .Where(x => x.IsNewCard && x.AccessCode == registerCardRequest.AccessCode)
+                .AsEnumerable()
+                .FirstOrDefault(x => string.IsNullOrEmpty(chipId) || x.ChipId == chipId);
+            if (cardProfile != null)
+                _logger.LogInformation("RegisterCard: empty SessionId, matched pending card {CardId} by access code", cardProfile.Id);
+        }
+
         if (cardProfile == null)
         {
             return Task.FromResult(response);
