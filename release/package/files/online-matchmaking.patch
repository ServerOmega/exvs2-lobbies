+namespace ServerInfinite.Models.Config;
+
+/// <summary>
+/// [exvs2-lobbies / EXPERIMENTAL, untested with the real game] Online tag (play with a specific partner from another
+/// shop), analysis/partner-invites.md. A tag team is created in the WebUI (partner's user id + invitation code); the
+/// card server then lists it in LoadCard.MobileUserGroup.tag_teams (36), the cabinet offers it under online tag and
+/// both cabinets search MMS world 5 with pair key = min(own pilot id, partner_id).
+/// </summary>
+public class OnlineTagConfigurations
+{
+    /// <summary>Send the card's tag teams in LoadCard.MobileUserGroup.tag_teams (field 36).</summary>
+    public bool SendTagTeams { get; set; } = true;
+
+    /// <summary>
+    /// TagTeamGroup.tag_status (required field, meaning unknown). 0 first (static analysis, partner-invites.md 6 Step A);
+    /// if the online-tag list stays empty in the game, try 1.
+    /// </summary>
+    public uint TagStatus { get; set; } = 0;
+
+    /// <summary>Max teams per card in the list (the WebUI allows 20 per leader).</summary>
+    public int MaxTeams { get; set; } = 20;
+
+    /// <summary>
+    /// The partner's invitation code works once: after a team is created with it, the partner gets a new code
+    /// (shown in their WebUI). false = upstream behaviour (the code never changes).
+    /// </summary>
+    public bool OneTimeInviteCode { get; set; } = true;
+}
diff --git a/Server-Infinite/Strategy/Team/OnlineTagTeamList.cs b/Server-Infinite/Strategy/Team/OnlineTagTeamList.cs
new file mode 100644
index 0000000..07da995
--- /dev/null
+++ b/Server-Infinite/Strategy/Team/OnlineTagTeamList.cs
@@ -0,0 +1,44 @@
+using nue.protocol.exvs;
+using ServerInfinite.Models.Cards;
+using ServerInfinite.Models.Config;
+using ServerInfinite.Persistence;
+
+namespace ServerInfinite.Strategy.Team;
+
+/// <summary>
+/// [exvs2-lobbies / EXPERIMENTAL] The online-tag list of one card (analysis/partner-invites.md 6 Step A): every tag team
+/// the card leads or is the partner of, with partner_id = the partner's pilot id (= its card id, the value the partner's
+/// cabinet sends as its own pilot id). The cabinet builds the MMS world-5 pair key as min(own pilot id, partner_id) and
+/// makes the lower id the leader, so both sides must see each other's real pilot id here.
+/// Cross-card-server tags (Step C) need globally unique pilot ids first; keep every pilot-id-on-the-wire value going
+/// through <see cref="WirePilotId"/> so a per-server id range can be added in one place.
+/// </summary>
+public static class OnlineTagTeamList
+{
+    public static uint WirePilotId(int cardId) => (uint)cardId;
+
+    public static List<TagTeamGroup> Build(ServerDbContext context, CardProfile cardProfile, OnlineTagConfigurations cfg)
+    {
+        var own = context.TagTeamDataDbSet
+            .Where(x => x.CardId == cardProfile.Id)
+            .ToList()
+            .Select(t => (Team: t, Partner: (int)t.TeammateCardId));
+        var asPartner = context.TagTeamDataDbSet
+            .Where(x => x.TeammateCardId == (uint)cardProfile.Id)
+            .ToList()
+            .Select(t => (Team: t, Partner: t.CardId));
+        return own.Concat(asPartner)
+            .Where(x => x.Partner != 0 && x.Partner != cardProfile.Id)      // never a team with yourself
+            .GroupBy(x => x.Team.Id).Select(g => g.First())                 // one entry per team
+            .OrderBy(x => x.Team.Id)
+            .Take(Math.Max(0, cfg.MaxTeams))
+            .Select(x =>
+            {
+                var g = TagTeamGroupBuilder.Build(context, x.Team, x.Partner, cfg.TagStatus);
+                g.PartnerId = WirePilotId(x.Partner);
+                g.GroupTagPoint = (uint)Math.Max(0, x.Team.OnlineRankPoint);
+                return g;
+            })
+            .ToList();
+    }
+}
