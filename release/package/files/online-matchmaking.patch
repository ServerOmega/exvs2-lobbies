+            : new[] { a, b }.OrderBy(u => u.LeaderNode).ToList();
+        var room = new Room
+        {
+            RoomId = _nextRoom++, At = now, World = a.World, Humans = 2,
+            Clients = ordered.Select(u => new RoomClient(0, u.Clients[0])).ToList(),
+        };
+        foreach (var u in ordered)
+        {
+            _queue.Remove(u);
+            u.Room = room;
+        }
+        Log?.Invoke($"MATCH room={room.RoomId} {a.WorldName} pair [{string.Join(",", ordered.Select(u => u.LeaderNode))}] " +
+                    $"key={a.Attr2} am=[{string.Join(",", ordered.Select(Am))}] (humans=2/2, both group 0)");
+        if (a.World == OnlineTagWorld)
+        {
+            var ams = ordered.Select(Am).ToList();
+            if (ams.All(x => x != 0) && ams.Min() != a.Attr2)
+                (Warn ?? Log)?.Invoke($"TAG-WARN room={room.RoomId} pair key {a.Attr2} != lower am_id {ams.Min()}: am_id is not the " +
+                                      "pilot id here (or ids come from different card servers) - leader/member may disagree");
+        }
+        var src = new Dictionary<uint, string>();
+        foreach (var u in ordered) foreach (var kv in u.SourceByNode) src[kv.Key] = kv.Value;
+        Log?.Invoke(NetDiag.MatchLine(room.RoomId, room.Clients.Select(c => (c.GroupId, c.Client)), src, Realms));
+    }
+
