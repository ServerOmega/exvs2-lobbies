+using System.Collections.Concurrent;
+using System.Net;
+using System.Net.Sockets;
+using Microsoft.Extensions.Options;
+using ServerInfinite.Models.Config;
+
+namespace ServerInfinite.Matchmaking;
+
+/// <summary>
+/// exvs2-lobbies: minimal RFC 5389 / RFC 5780 STUN server so the card server can be the only program a host runs.
+/// Answers Binding requests with XOR-MAPPED-ADDRESS, MAPPED-ADDRESS, RESPONSE-ORIGIN and OTHER-ADDRESS, and honours
+/// CHANGE-REQUEST: change-port answers from the alternate port; change-IP answers from the alternate IP when
+/// BuiltinStunAltIp is set, otherwise (single-IP host) from the alternate port so the cabinet's NAT test still completes.
+/// </summary>
+public sealed class BuiltinStunServer : BackgroundService
+{
+    const uint MagicCookie = 0x2112A442;
+    readonly OnlineMatchingConfigurations _mm;
+    readonly ILogger<BuiltinStunServer> _log;
+    readonly ConcurrentDictionary<string, DateTime> _seen = new();
+    // [ipIndex, portIndex] -> socket ; ipIndex 1 / portIndex 1 = alternate
+    readonly UdpClient?[,] _socks = new UdpClient?[2, 2];
+    IPAddress _ip0 = IPAddress.Any, _ip1 = IPAddress.Any;
+    IPAddress _advertised0 = IPAddress.Loopback, _advertised1 = IPAddress.Loopback;
+    int _port0, _port1;
+    bool _hasAltIp;
+
+    public BuiltinStunServer(IOptions<CardServerConfig> cfg, ILogger<BuiltinStunServer> log)
+    {
+        _mm = cfg.Value.OnlineMatching;
+        _log = log;
+    }
+
+    protected override async Task ExecuteAsync(CancellationToken ct)
+    {
+        if (!_mm.Enabled || !_mm.BuiltinStun) return;
+        _port0 = _mm.BuiltinStunPort == 0 ? (int)_mm.StunPort : (int)_mm.BuiltinStunPort;
+        _port1 = (int)(_mm.BuiltinStunAltPort == 0 ? (uint)_port0 + 1 : _mm.BuiltinStunAltPort);
+        IPAddress.TryParse(_mm.StunHost?.Trim(), out var stunIp);
+        _hasAltIp = IPAddress.TryParse(_mm.BuiltinStunAltIp?.Trim(), out var altIp);
+        if (_hasAltIp)
+        {
+            // two local addresses: bind each explicitly so replies leave from the right one
+            _ip0 = stunIp ?? IPAddress.Any; _ip1 = altIp!;
+        }
+        _advertised0 = stunIp ?? IPAddress.Loopback;
+        _advertised1 = _hasAltIp ? altIp! : _advertised0;
+
+        try
+        {
+            _socks[0, 0] = Bind(_ip0, _port0);
+            _socks[0, 1] = Bind(_ip0, _port1);
+            if (_hasAltIp)
+            {
+                _socks[1, 0] = Bind(_ip1, _port0);
+                _socks[1, 1] = Bind(_ip1, _port1);
+            }
+        }
+        catch (Exception e)
+        {
+            _log.LogError("STUN built-in server could not bind UDP {Port}/{Alt}: {Error}", _port0, _port1, e.Message);
+            return;
+        }
+        _log.LogInformation("STUN built-in server on UDP {Port} (+alt {Alt}){AltIp}; advertising OTHER-ADDRESS {Other}:{Alt}",
+            _port0, _port1, _hasAltIp ? $", alt IP {_ip1}" : " single-IP (change-IP answered from alt port)",
+            _advertised1, _port1);
+        if (stunIp == null)
+            _log.LogWarning("NET-WARN STUN: StunHost is not an IP literal; OTHER-ADDRESS will say 127.0.0.1 - set StunHost to this host's address");
+
+        var tasks = new List<Task>();
+        for (var i = 0; i < 2; i++)
+        for (var p = 0; p < 2; p++)
+            if (_socks[i, p] is { } s) tasks.Add(Loop(s, i, p, ct));
+        try { await Task.WhenAll(tasks); }
+        finally { foreach (var s in _socks) s?.Dispose(); }
+    }
+
+    static UdpClient Bind(IPAddress ip, int port)
+    {
+        var u = new UdpClient(AddressFamily.InterNetwork);
+        if (OperatingSystem.IsWindows())
+        {
+            const int SIO_UDP_CONNRESET = -1744830452; // ignore ICMP port-unreachable resets
+            u.Client.IOControl(SIO_UDP_CONNRESET, new byte[] { 0 }, null);
+        }
+        u.Client.Bind(new IPEndPoint(ip, port));
+        return u;
+    }
+
+    async Task Loop(UdpClient sock, int ipIdx, int portIdx, CancellationToken ct)
+    {
+        while (!ct.IsCancellationRequested)
+        {
+            UdpReceiveResult r;
+            try { r = await sock.ReceiveAsync(ct); }
+            catch (OperationCanceledException) { break; }
+            catch (SocketException) { continue; }
+            try { Handle(r.Buffer, r.RemoteEndPoint, ipIdx, portIdx); }
+            catch (Exception e) { _log.LogDebug("STUN bad packet from {Ep}: {Error}", r.RemoteEndPoint, e.Message); }
+        }
+    }
+
+    void Handle(byte[] d, IPEndPoint from, int ipIdx, int portIdx)
+    {
+        if (d.Length < 20 || (d[0] & 0xC0) != 0) return;
+        var type = (d[0] << 8) | d[1];
+        if (type != 0x0001) return; // Binding request only
+        var len = (d[2] << 8) | d[3];
+        var cookie = (uint)((d[4] << 24) | (d[5] << 16) | (d[6] << 8) | d[7]);
+        var rfc5389 = cookie == MagicCookie;
+        bool changeIp = false, changePort = false;
+        for (var i = 20; i + 4 <= Math.Min(d.Length, 20 + len);)
+        {
+            var at = (d[i] << 8) | d[i + 1];
+            var al = (d[i + 2] << 8) | d[i + 3];
+            if (at == 0x0003 && al >= 4)
+            {
+                changeIp = (d[i + 7] & 0x04) != 0;
+                changePort = (d[i + 7] & 0x02) != 0;
+            }
+            i += 4 + al + ((4 - al % 4) % 4);
+        }
+
+        var outIp = ipIdx; var outPort = portIdx;
+        if (changeIp)
+        {
+            if (_hasAltIp) outIp = 1 - ipIdx;
+            else outPort = 1 - portIdx; // single-IP host: best effort
+        }
+        if (changePort) outPort = 1 - portIdx;
+        if (changeIp && !_hasAltIp && changePort) outPort = 1 - portIdx; // both requested, one IP: still the other port
+        var sock = _socks[outIp, outPort] ?? _socks[0, outPort] ?? _socks[0, 0]!;
+        var originIp = outIp == 1 ? _advertised1 : _advertised0;
+        var originPort = outPort == 1 ? _port1 : _port0;
+        var otherIp = ipIdx == 1 ? _advertised0 : _advertised1;
+        var otherPort = portIdx == 1 ? _port0 : _port1;
+
+        var body = new List<byte>();
+        var fromIp = from.Address.IsIPv4MappedToIPv6 ? from.Address.MapToIPv4() : from.Address;
+        AddAddr(body, 0x0001, fromIp, from.Port, false, d);
+        if (rfc5389) AddAddr(body, 0x0020, fromIp, from.Port, true, d);
+        AddAddr(body, rfc5389 ? 0x802b : 0x0004, originIp, originPort, false, d); // RESPONSE-ORIGIN / SOURCE-ADDRESS
+        AddAddr(body, rfc5389 ? 0x802c : 0x0005, otherIp, otherPort, false, d);   // OTHER-ADDRESS / CHANGED-ADDRESS
+        var msg = new byte[20 + body.Count];
+        msg[0] = 0x01; msg[1] = 0x01; // Binding success
+        msg[2] = (byte)(body.Count >> 8); msg[3] = (byte)body.Count;
+        Array.Copy(d, 4, msg, 4, 16); // cookie + transaction id
+        body.CopyTo(msg, 20);
+        sock.Send(msg, msg.Length, from);
+
+        var key = $"{fromIp}:{from.Port}";
+        var now = DateTime.UtcNow;
+        if (_mm.VerboseLog || !_seen.TryGetValue(key, out var last) || (now - last).TotalSeconds > 60)
+        {
+            _seen[key] = now;
+            _log.LogInformation("NET stun from={From} via={Via} change={Change} -> reply from {OIp}:{OPort}",
+                key, $"{(ipIdx == 1 ? _advertised1 : _advertised0)}:{(portIdx == 1 ? _port1 : _port0)}",
+                (changeIp ? "ip" : "") + (changePort ? "port" : "") is var c && c.Length > 0 ? c : "none",
+                originIp, originPort);
+        }
+    }
+
+    static void AddAddr(List<byte> b, int type, IPAddress ip, int port, bool xor, byte[] req)
+    {
+        var a = ip.GetAddressBytes();
+        if (a.Length != 4) return;
+        var p = port;
+        if (xor)
+        {
+            p ^= 0x2112;
+            for (var i = 0; i < 4; i++) a[i] ^= req[4 + i];
+        }
+        b.Add((byte)(type >> 8)); b.Add((byte)type); b.Add(0); b.Add(8);
+        b.Add(0); b.Add(0x01); b.Add((byte)(p >> 8)); b.Add((byte)p);
+        b.AddRange(a);
+    }
+}
