         _hasAltIp = IPAddress.TryParse(_mm.BuiltinStunAltIp?.Trim(), out var altIp);
-        if (_hasAltIp)
-        {
-            // two local addresses: bind each explicitly so replies leave from the right one
-            _ip0 = stunIp ?? IPAddress.Any; _ip1 = altIp!;
-        }
+        // Bind to StunHost when it is one of this machine's addresses, so replies always leave from it.
+        // On a multi-homed Windows box a 0.0.0.0 socket can answer from another interface's IP, and the
+        // game drops replies whose source is not the STUN server it asked.
+        _ip0 = stunIp != null && IsLocal(stunIp) ? stunIp : IPAddress.Any;
+        if (_hasAltIp) _ip1 = altIp!;
         _advertised0 = stunIp ?? IPAddress.Loopback;
         _advertised1 = _hasAltIp ? altIp! : _advertised0;
 
@@ -75,6 +75,18 @@ public sealed class BuiltinStunServer : BackgroundService
         finally { foreach (var s in _socks) s?.Dispose(); }
     }
 
+    static bool IsLocal(IPAddress ip)
+    {
+        try
+        {
+            foreach (var ni in System.Net.NetworkInformation.NetworkInterface.GetAllNetworkInterfaces())
+            foreach (var ua in ni.GetIPProperties().UnicastAddresses)
+                if (ua.Address.Equals(ip)) return true;
+        }
+        catch { }
+        return false;
+    }
